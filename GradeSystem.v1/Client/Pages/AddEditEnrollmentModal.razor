@inject DialogService DialogService
@inject IEnrollmentService EnrollmentService
@inject ILessonsHoursService LessonsHoursService

<div class="search-container-modal">
    <RadzenTemplateForm TItem="Enrollment" Data="enrollment" Submit="HandleSubmit" InvalidSubmit="InvalidSubmit">
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Subject" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@enrollment.SubjectID Chips=true Placeholder="Search..." Name="Subject" Data=EnrollmentService.Subjects TextProperty="SubjectName" ValueProperty="SubjectID" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" />
                <RadzenRequiredValidator Component="Subject" Text="Please select subject" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Class" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@enrollment.ClassID Chips=true Placeholder="Search..." Name="Class" Data=EnrollmentService.Classes TextProperty="ClassName" ValueProperty="ClassID" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" />
                <RadzenRequiredValidator Component="Class" Text="Please select class" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Class Room" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="enrollment.ClassRoom" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" Name="ClassRoom" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Description" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="enrollment.Description" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" Name="Description" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Date" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDatePicker TValue="DateTime" Value=@value Name="Date" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" CurrentDateChanged="OnCurrentDateChanged" DateFormat="yyyy/MM/dd" />
                <RadzenRequiredValidator Component="Date" Text="Please select date" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Lesson number" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@selectedKey Chips=true Placeholder="Search..." Name="LessonNumber" Data=LessonsHoursService.LessonsHours ValueProperty="LessonNo" TextProperty="LessonNo" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" />
                <RadzenRequiredValidator Component="LessonNumber" Text="Please select lesson number" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="button-container search-margin">
            <button class="rounded-empty-button" type="submit">Confirm</button>
            <button class="rounded-filled-button" type="button" onclick="@Close">Cancel</button>
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter]
    public int? ID { get; set; }
    Enrollment enrollment = new Enrollment();
    DateTime value = DateTime.Now.Date;
    int? selectedKey=null;
    protected override async Task OnParametersSetAsync()
    {
        await LessonsHoursService.GetLessonsHours();
        await EnrollmentService.GetClasses();
        await EnrollmentService.GetSubjects();
        if (ID != null)
        {
            enrollment = await EnrollmentService.GetEnrollmentByID((int)ID);
            value = enrollment.Date;
            selectedKey = LessonsHoursService.LessonsHours.FirstOrDefault(ls => ls.Start.TimeOfDay == enrollment.Date.TimeOfDay).LessonNo;
        }
    }
    void OnCurrentDateChanged(DateTime args)
    {
        value = new DateTime(args.Year, args.Month, args.Day);
    }
    private void Close()
    {
        DialogService.Close();
    }
    private async Task HandleSubmit()
    {
        enrollment.Date = value + LessonsHoursService.LessonsHours[(int)selectedKey - 1].Start.TimeOfDay;
        enrollment.EndDate = value + LessonsHoursService.LessonsHours[(int)selectedKey - 1].End.TimeOfDay;
        if (ID == null)
        {
            await EnrollmentService.CreateEnrollment(enrollment);
        }
        else
        {
            await EnrollmentService.UpdateEnrollment(enrollment);
        }
        await InvokeAsync(StateHasChanged);
        Close();
    }
    private void InvalidSubmit()
    {

    }
}
