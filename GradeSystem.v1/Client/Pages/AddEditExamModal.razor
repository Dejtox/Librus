@inject DialogService DialogService
@inject IExamService ExamService
@inject IEnrollmentService EnrollmentService
@inject ILessonsHoursService LessonsHoursService

<div class="search-container-modal">
    <RadzenTemplateForm TItem="Exam" Data="exam" Submit="HandleSubmit" InvalidSubmit="InvalidSubmit">
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Subject" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="subject.SubjectName" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" Name="Subject" ReadOnly="true" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Date" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDatePicker TValue="DateTime" Value=@dateTime1 Name="Date" CurrentDateChanged="OnCurrentDateChanged"
                                  Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" DateFormat="yyyy/MM/dd" />
                <RadzenRequiredValidator Component="Date" Text="Please select date" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Lesson number" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@selectedKey Chips=true Placeholder="Search..." Name="LessonNumber" Data=LessonsHoursService.LessonsHours TextProperty="LessonNo" ValueProperty="LessonNo" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" />
                <RadzenRequiredValidator Component="LessonNumber" Text="Please select lesson number" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Grade" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="grade.ClassName" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" Name="Class" ReadOnly="true" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Description" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="exam.Description" Style="font-weight:bold;font-size:17px;margin:0;border-radius:15px;width:40%;" Name="Description" />
                <RadzenLengthValidator Component="Description" Min="2" Text="Description should be at least 2 characters" Popup="false" Style="" />
                <RadzenLengthValidator Component="Description" Max="500" Text="Description should be at most 500 characters" Popup="false" Style="" />
            </RadzenStack>
        </div>
        <div class="button-container search-margin">
            <button class="rounded-empty-button" type="submit">Confirm</button>
            <button class="rounded-filled-button" type="button" onclick="@Close">Cancel</button>
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter]
    public int? ID { get; set; }//exam jak do edita
    [Parameter]
    public int? EnrollmentID { get; set; }
    public Exam exam { get; set; } = new Exam() {};
    public Class grade { get; set; } = new Class();
    public Subject subject { get; set; } = new Subject();
    DateTime dateTime1 = DateTime.Now;
    int selectedKey;
    void OnCurrentDateChanged(DateTime args)
    {
        dateTime1 = new DateTime(args.Year, args.Month, args.Day);
    }
    protected override async Task OnParametersSetAsync()
    {
        await LessonsHoursService.GetLessonsHours();
        if (ID != null)
        {
            exam = await ExamService.GetExamByID((int)ID);
            grade = exam.Class;
            subject = exam.Subject;
        }
        if(EnrollmentID != null)
        {
            Enrollment enrollment = await EnrollmentService.GetEnrollmentByID((int)EnrollmentID);
            exam.SubjectID = (int)enrollment.SubjectID;
            exam.ClassID = (int)enrollment.ClassID;
            grade = enrollment.Class;
            subject = enrollment.Subject;
        }
    }
    private void Close()
    {
        DialogService.Close();
    }
    private async Task HandleSubmit()
    {
        exam.Date = dateTime1 + LessonsHoursService.LessonsHours[selectedKey - 1].Start.TimeOfDay;
        if (ID == null)
        {
            await ExamService.CreateExam(exam);
        }
        else
        {
            await ExamService.UpdateExam(exam);
        }
        Close();
    }
    private void InvalidSubmit()
    {

    }
}
