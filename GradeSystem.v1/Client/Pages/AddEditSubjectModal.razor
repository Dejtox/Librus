@inject DialogService DialogService
@inject ISubjectService SubjectService
@attribute [Authorize(Roles = "Teacher, Admin, Assistant")]

<div class="search-container">
    <RadzenTemplateForm TItem="Subject" Data="subject" Submit="HandleSubmit" InvalidSubmit="InvalidSubmit">
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Subject Name" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenTextBox @bind-Value="subject.SubjectName" Style="font-weight:bold;font-size:17px;margin:0;" Name="SubjectName"/>
                <RadzenLengthValidator Component="SubjectName" Min="2" Text="Subject name should be at least 2 characters" Popup="true" Style="display:block;" />
                <RadzenLengthValidator Component="SubjectName" Max="50" Text="Subject name should be at most 50 characters" Popup="true" Style="display:block;" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Teacher" Style="font-weight:bold;width:10%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@subject.TeacherID Chips=true Placeholder="Search..." Name="TeacherDD" Data=SubjectService.Teachers TextProperty="Name" ValueProperty="TeacherID" Style="font-weight:bold;font-size:17px;margin:0;" />
                <RadzenRequiredValidator Component="TeacherDD" Text="Please select at least one teacher" Popup="true" Style="display:block;" />
            </RadzenStack>
        </div>
        <div class="button-container search-margin">
            <button class="rounded-empty-button" type="submit">Confirm</button>
            <button class="rounded-filled-button" type="button" onclick="@Close">Cancel</button>
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter]
    public int? ID { get; set; }
    Subject subject = new Subject();

    protected override async Task OnParametersSetAsync()
    {
        if (ID != null)
        {
            subject = await SubjectService.GetSubjectByID((int)ID);
        }
        await SubjectService.GetTeachers();
    }
    private void Close()
    {
        DialogService.Close();
    }
    private async Task HandleSubmit()
    {
        if (ID == null)
        {
            await SubjectService.CreateSubject(subject);
        }
        else
        {
            await SubjectService.UpdateSubject(subject);
        }


    }
    private void InvalidSubmit()
    {

    }
}
