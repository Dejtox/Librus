@inject IGradeService GradeService
@inject IStudentService StudentService
@inject ISubjectService SubjectService
@inject DialogService DialogService
@inject IGradeNumberService GradeNumberService
@attribute [Authorize(Roles = "Teacher, Admin, Assistant")]

<div class="search-container">
    <div class="empty-row"></div>
    <RadzenTemplateForm Data="grade" TItem="Grade" Submit="HandleSubmit">
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Name" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenText Text="@grade.Student?.Name" Style="font-weight:bold;font-size:17px;margin:0;" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Trip name" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenText Text="@grade.Subject?.SubjectName" Style="font-weight:bold;font-size:17px;margin:0;" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Type" Component="type" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenDropDown @bind-Value="@grade.GradeTypeId" Data=@GradeNumberService.GradeTypes Style="width: 30%; border-radius:15px;" Name="type" ValueProperty="GradeTypeId" TextProperty="GradeTypeName" Placeholder="Search..." />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Grade" Component="graden" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenDropDown @bind-Value="@grade.GradeNumberID" Data=@GradeNumberService.GradeNumbers Style="width: 30%; border-radius:15px;" Name="graden" ValueProperty="GradeNumberID" TextProperty="GradeName" Placeholder="Search..." />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Date" Component="Date" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenDatePicker Name="Date" @bind-Value="grade.DateOfGrading" Style="width: 30%;border-radius:15px;" Placeholder="Select date" ShowTime="true" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="search-margin l-margin">
                <RadzenLabel Text="Description" Component="Description" Style="font-weight:bold;width:15%;font-size:17px;" />
                <RadzenTextArea Name="Description" @bind-Value="grade.Description" Style="width: 70%; border-radius:15px;" />
            </RadzenStack>
        </div>
        <div class="button-container search-margin">
            <button class="rounded-empty-button" type="submit">Confirm</button>
            <button class="rounded-filled-button" type="button" onclick="@Close">Cancel</button>
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Parameter]
    public int? ID { get; set; }
    [Parameter]
    public int? SubjectID { get; set; }
    // List<GradeType> gradeTypes = new List<GradeType>() { new GradeType() { GradeWeight = 1, GradeTypeName = "Homework", color = "green" }, new GradeType() { GradeWeight = 2, GradeTypeName = "Exam", color = "red" } };
