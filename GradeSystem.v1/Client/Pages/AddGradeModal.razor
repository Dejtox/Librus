    //     new GradeNumber(){gradenumber=4.3f,GradeName="4+"},
    //     new GradeNumber(){gradenumber=4.6f,GradeName="5-"},
    //     new GradeNumber(){gradenumber=5.0f,GradeName="5"},
    //     new GradeNumber(){gradenumber=5.0f,GradeName="5+"},
    //     new GradeNumber(){gradenumber=5.0f,GradeName="6-"},
    //     new GradeNumber(){gradenumber=6.0f,GradeName="6"},
    // };

    Grade grade = new Grade();

    protected override async Task OnParametersSetAsync()
    {
        Student student = await StudentService.GetStudentById((int)ID);
        Subject subject = await SubjectService.GetSubjectByID((int)ID);
        grade.Subject = subject;
        grade.Student = student;
        grade.SubjectID = subject.SubjectID;
        grade.StudentID = student.StudentID;
    }
    protected override async Task OnInitializedAsync()
    {
        await GradeNumberService.GetGradeNumbers();
        await GradeNumberService.GetGradeTypes();
    }
    private async Task HandleSubmit()
    {
        grade.GradeWeight = 0;
        await GradeService.CreateGrade(grade);
    }
    private void Close()
    {
        DialogService.Close();
    }

    private async void MockData()
