@page "/addstuff"
@inject DialogService DialogService
@inject IStudentService StudentService
<div class="subwebsitebody">
    <div class="addbuttons">

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="students" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Students
            </NavLink>
        </div>

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="parents" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Parents
            </NavLink>
        </div>

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="teachers" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Teachers
            </NavLink>
        </div>

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="classes" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Classes
            </NavLink>
        </div>

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="subjects" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Subjects
            </NavLink>
        </div>

        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="enrollments" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Enrollments
            </NavLink>
        </div>
        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="AttendanceViewSingleStudent" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add Attendance
            </NavLink>
        </div>
        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="attendanceviewstudents" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add  Attendance class
            </NavLink>
        </div>
        <div class="sidebar-buttoncontainer">
            <div class="header-element">
                <i class="gg-add"></i>
            </div>
            <NavLink class="main-menutextcomponet" href="AddSerialGrades" Match="NavLinkMatch.All">
                <span class="oi oi-people" aria-hidden="true"></span> Add grade
            </NavLink>
        </div>
    <button onclick="@AddAttendance">Add Attendance</button>
    <button onclick="@AddAttendanceClass">Add Attendance class</button>
    <button onclick="@AddGrade">Add grade</button>


    </div>
</div>

@code {

    private async Task AddAttendance()
    {
        //mock data
        Student student = await StudentService.GetStudentById(1);
        await DialogService.OpenAsync<AddAttendanceModal>("Add attendance",
            new Dictionary<string, object>() { { "ID", student.StudentID } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 40%;border-radius: 20px;height: 40%;"
                });
    }
    private async Task AddAttendanceClass()
    {
        Student student = await StudentService.GetStudentById(1);
        await DialogService.OpenAsync<AddAttendanceClassModal>("Add attendance",
            new Dictionary<string, object>() { { "ID", student.ClassID } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 40%;border-radius: 20px;height: 40%;"
                });
    }
    private async Task AddGrade()
    {
        Student student = await StudentService.GetStudentById(1);
        await DialogService.OpenAsync<AddGradeModal>("Add grade",
            new Dictionary<string, object>() { { "ID", student.StudentID },{"SubjectID", 1} },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 40%;border-radius: 20px;height: 40%;"
                });
    }
}
