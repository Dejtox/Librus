@page "/AdminEnrollments"
@inject IEnrollmentService EnrollmentService
@inject DialogService DialogService

<RadzenDataGrid @ref="EnrollmentGrid" TItem="Enrollment" Data="EnrollmentService.EnrollmentsWithoutDuplicates" AllowFiltering="true" AllowColumnResize="true"
                FilterMode="FilterMode.Advanced" PageSize="5" AllowPaging="true" AllowSorting="true" ColumnWidth="100px"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" TItem="Teacher" AllowAlternatingRows="false" ShowPagingSummary="true"
                LogicalFilterOperator="LogicalFilterOperator.Or" FilterPopupRenderMode="PopupRenderMode.OnDemand" Sort="@(args => ResetIndex(true))" Page="@(args => ResetIndex(true))" Filter="@(args => ResetIndex(true))">
    <Columns>
        <RadzenDataGridColumn Title="No." TItem="Enrollment" Sortable=false Filterable=false>
            <Template>
                @{
                    var pageSize = Math.Min(EnrollmentGrid.PageSize, EnrollmentGrid.View.Count());
                }
                <RenderOnceComponent CanRender=@(!(index >= pageSize))>
                    @{
                        ResetIndex(index >= pageSize);
                    }
                    @((EnrollmentGrid.CurrentPage * pageSize) + index++ + 1)
                </RenderOnceComponent>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Enrollment.Date" Title="Start Date" TItem="Enrollment" />
        <RadzenDataGridColumn Property="Enrollment.EndDate" Title="End Date" TItem="Enrollment" />
        <RadzenDataGridColumn Property="Enrollment.ClassRoom" Title="Class Room" TItem="Enrollment" />
        <RadzenDataGridColumn Property="Enrollment.Class.ClassName" Title="Class" TItem="Enrollment" />
        <RadzenDataGridColumn Property="Enrollment.Subject.SubjectName" Title="Subject" TItem="Enrollment" />
        <RadzenDataGridColumn Title="Has Substitution" TItem="Enrollment">
            <Template Context="Enrollment">
                @if (Enrollment.SubEnrollmentID != null)
                {
                    <p>Yeah</p>
                }
                else
                {
                    <p>Nah</p>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Options" TItem="Enrollment">
            <Template Context="Enrollment">
                <div class="options" style="padding:3px;">
                    <button type="button" class="icon-button" onclick="@(()=>Edit(Enrollment.EnrollmentID))">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="icon-button" onclick="@(()=>Delete(Enrollment.EnrollmentID))">
                        <i class="bi bi-trash"></i>
                    </button>
                    @if (Enrollment.SubEnrollmentID == null)
                    {
                        <button type="button" class="rounded-filled-button" onclick="@(()=>AddSubstitution(Enrollment.EnrollmentID))">Substitute</button>
                    }
                    else
                    {
                        <button type="button" class="rounded-filled-button" disabled="true">Substitute</button>
                    })
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<div class="center search-margin">
    <button class="trip-add-button" @onclick="AddEnrollment">Add enrollment</button>
</div>

@code {
    RadzenDataGrid<Enrollment> EnrollmentGrid;
    int index;
    void ResetIndex(bool shouldReset)
    {
        if (shouldReset)
        {
            index = 0;
        }
    }
    //filtercleared

    protected override async Task OnInitializedAsync()
    {
        await EnrollmentService.GetEnrollmentsWithoutDuplicates();
    }
    private async Task Edit(int id)
    {
        await DialogService.OpenAsync<AddEditEnrollmentModal>("Edit enrollment",
            new Dictionary<string, object>() { { "ID", id } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 30%;border-radius: 20px;height: 40%;"
                });
    }
    private async Task Delete(int subjectID)
    {
        var result = await DialogService.Confirm("Are you sure?", "Confirmation", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (result.HasValue && result.Value)
        {
            await EnrollmentService.DeleteEnrollment(subjectID);
        }
    }
    private async Task AddEnrollment()
    {
        await DialogService.OpenAsync<AddEditEnrollmentModal>("Add enrollment",
            null,
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 30%;border-radius: 20px;height: 40%;"
                });
    }

    private async Task AddSubstitution(int id)
    {
        await DialogService.OpenAsync<AddSubstitutionModal>("Add substitution",
            new Dictionary<string, object>() { { "ID", id } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 30%;border-radius: 20px;height: 40%;"
                });
    }
}

