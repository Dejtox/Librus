
@page "/AdminPage"

<div class="subwebsitebody">
    <di class="AdminMainBox">
        <div class="AdminTopBar">
            <button class="AdminButton AdminTeachers @(Button == "Teacher" ? "active" : "")" @onclick="TeacherButton">
                Teachers
            </button>
            <button class="AdminButton AdminStudents @(Button == "Student" ? "active" : "")" @onclick="StudentButton">
                Students
            </button>
            <button class="AdminButton AdminParents @(Button == "Parent" ? "active" : "")" @onclick="ParentButton">
                Parents
            </button>
            <button class="AdminButton AdminSubjects @(Button == "Subject" ? "active" : "")" @onclick="SubjectButton">
                Subjects
            </button>
            <button class="AdminButton AdminClasses @(Button == "Class" ? "active" : "")" @onclick="ClassButton">
                Classes
            </button>
            <button class="AdminButton AdminEnrollments @(Button == "Enrollment" ? "active" : "")" @onclick="EnrollmentButton">
                Enrollments
            </button>
        </div>

        <div class="AdminDisplay">

               @if (Button == "Teacher"){
                    <AdminTeachers @ref="siteref"></AdminTeachers>
               }
               else if(Button=="Student"){
                    <AdminStudents @ref="siteref1"></AdminStudents>
               }
               else if(Button=="Parent"){
                    <AdminParents @ref="siteref2"></AdminParents>
               }
               else if(Button=="Subject"){
                    <AdminSubjects @ref="siteref3"></AdminSubjects>
               }
               else if(Button=="Class"){
                    <AdminClasses @ref="siteref4"></AdminClasses>
               }
               else if(Button=="Enrollment"){
                    <AdminEnrollments @ref="siteref5"></AdminEnrollments>
               }
   
        </div>
    </di>
</div>
