@* @inherits LayoutComponentBase
@layout MainLayout  *@
@page "/AdminPage"

<div class="subwebsitebody">
    <di class="AdminMainBox">
        <div class="AdminTopBar">
            <button class="AdminButton AdminTeachers" @onclick="TeacherButton">
                Teachers
            </button>
            <button class="AdminButton AdminStudents" @onclick="StudentButton">
                Students
            </button>
            <button class="AdminButton AdminParents" @onclick="ParentButton">
                Parents
            </button>
            <button class="AdminButton AdminSubjects" @onclick="SubjectButton">
                Subjects
            </button>
            <button class="AdminButton AdminClasses" @onclick="ClassButton">
                Classes
            </button>
            <button class="AdminButton AdminEnrollments" @onclick="EnrollmentButton">
                Enrollments
            </button>

        </div>
        <div class="AdminDisplay">
            <div class="AdminSubDisplay">

               @if (Button == "Teacher"){
                    <AdminTeachers @ref="siteref"></AdminTeachers>
               }
               else if(Button=="Student"){
                    <AdminStudents @ref="siteref1"></AdminStudents>
               }
               else if(Button=="Parent"){
                    <AdminParents @ref="siteref2"></AdminParents>
               }
               else if(Button=="Subject"){
                    <AdminSubjects @ref="siteref3"></AdminSubjects>
               }
               else if(Button=="Class"){
                    <AdminClasses @ref="siteref4"></AdminClasses>
               }
               else if(Button=="Enrollment"){
                    <AdminEnrollments @ref="siteref5"></AdminEnrollments>
               }
   

            </div>
        </div>
    </di>
</div>


@code {

    private AdminTeachers siteref;
    private AdminStudents siteref1;
    private AdminParents siteref2;
    private AdminSubjects siteref3;
    private AdminClasses siteref4;
    private AdminEnrollments siteref5;


    public string Button = null;

    public void TeacherButton()
    {
        Button = "Teacher";
    }

    public void StudentButton()
    {
        Button = "Student";

    }
    public void ParentButton()
    {
        Button = "Parent";

    }
    public void SubjectButton()
    {
        Button = "Subject";

    }
    public void ClassButton()
    {
        Button = "Class";

    }
    public void EnrollmentButton()
    {
        Button = "Enrollment";

    }
}