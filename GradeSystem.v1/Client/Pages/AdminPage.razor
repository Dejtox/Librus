@code {
    private AdminTeachers siteref;
    private AdminStudents siteref1;
    private AdminParents siteref2;
    private AdminSubjects siteref3;
    private AdminClasses siteref4;
    private AdminEnrollments siteref5;

    public string Button = null;

    public void TeacherButton() => Button = "Teacher";
    public void StudentButton() => Button = "Student";
    public void ParentButton() => Button = "Parent";
    public void SubjectButton() => Button = "Subject";
    public void ClassButton() => Button = "Class";
    public void EnrollmentButton() => Button = "Enrollment";
}
