@page "/AdminStatistics/Enrollments"
@inject IAttendanceService AttendanceService
@inject IEnrollmentService EnrollmentService
@inject ITeacherService TeacherService
@inject IClassService ClassService
@inject ISubjectService SubjectService
@inject IStudentService StudentService
@inject NavigationManager NavigationManager

<h3>Statystyki</h3>
<div class="card mb-4">
    <div class="card-header">
        <h4>Statystyki Lekcji według Klas i Przedmiotów</h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="classSelect" class="form-label">Wybierz Klasę</label>
                <select id="classSelect" class="form-select" @bind="SelectedClassId">
                    <option value="0">Pokaż Wszystkie</option>

                    @foreach(var classObj in ClassService.Classes.OrderBy(c => c.ClassName))
                    {
                        <option value="@classObj.ClassID">@classObj.ClassName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="teacherSelect" class="form-label">Wybierz Nauczyciela</label>
                <select id="teacherSelect" class="form-select" @bind="SelectedTeacherId">
                    <option value="0">Pokaż Wszystkich</option>
                    @foreach(var teacher in TeacherService.Teachers.OrderBy(t => t.LastName).ThenBy(t => t.FirstName))
                    {
                        <option value="@teacher.TeacherID">@teacher.LastName @teacher.FirstName</option>
                    }
                </select>
            </div>
        </div>
        @if(isLoading)
        {
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Ładowanie...</span>
                </div>
            </div>
        } else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Klasa</th>
                            <th>Przedmiot</th>
                            <th>Nauczyciel</th>
                            <th>Liczba Lekcji</th>
                            <th>Zrealizowane Lekcje</th>
                            <th>Stopień Realizacji</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var stat in FilteredClassSubjectStatistics)
                        {
                            <tr>
                                <td>
                                    @GetClassName(stat.ClassID)
                                </td>
                                <td>
                                    @GetSubjectName(stat.SubjectID)
                                </td>
                                <td>
                                    @GetTeacherName(GetSubjectTeacherId(stat.SubjectID))
                                </td>
                                <td>
                                    @stat.TotalLessons
                                </td>
                                <td>
                                    @stat.CompletedLessons
                                </td>
                                <td>
                                    @if(stat.TotalLessons>0)
                                    {
                                        <div class="progress">
                                            <div class="progress-bar" role="progressbar" style="width:@FormatPercentage(stat.CompletionRate);" aria-valuenow="@stat.CompletionRate" aria-valuemin="0" aria-valuemax="100">
                                                @stat.CompletionRate.ToString("F1")%
                                            </div>
                                        </div>
                                    } else
                                    {
                                        <span>
                                            N/A
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5>Podsumowanie</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Liczba klas w systemie:</strong> @ClassService.Classes.Count()</p>
                            <p><strong>Liczba przedmiotów w systemie:</strong> @SubjectService.Subjects.Count()</p>
                            <p><strong>Ilość lekcji w systemie:</strong> @EnrollmentService.Enrollments.Count()</p>
                            <p><strong>Średni stopień realizacji:</strong> @(totalLessons>0 ? ((double)totalCompletedLessons/totalLessons*100).ToString("F1")+"%" : "N/A")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5>Aktualne Dane</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Liczba wyświetlanych klas:</strong> @GetFilteredClassesCount()</p>
                            <p><strong>Liczba wyświetlanych przedmiotów:</strong> @GetFilteredSubjectsCount()</p>
                            <p><strong>Ilość filtrowanych lekcji:</strong> @GetFilteredLessonsCount()</p>
                            <p><strong>Średni stopień realizacji(aktualne filtry):</strong> @GetFilteredCompletionRate()</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }
    private bool isLoading = true;
    private int SelectedClassId { get; set; } = 0;
    private int SelectedTeacherId { get; set; } = 0;

    private List<ClassSubjectStatistic> classSubjectStatistics = new List<ClassSubjectStatistic>();

    private IEnumerable<ClassSubjectStatistic> FilteredClassSubjectStatistics =>
    classSubjectStatistics.Where(s => (SelectedClassId == 0 || s.ClassID == SelectedClassId) && (SelectedTeacherId == 0 || GetSubjectTeacherId(s.SubjectID) == SelectedTeacherId));
    // SelectedClassId == 0
    //     ? classSubjectStatistics
    //     : classSubjectStatistics.Where(s => s.ClassID == SelectedClassId);

    private int totalLessons = 0;

    private int totalCompletedLessons = 0;

    private string GetFilteredCompletionRate()
    {
        var filteredStats = FilteredClassSubjectStatistics.ToList();
        var filteredTotalLessons = filteredStats.Sum(s => s.TotalLessons);
        var filteredCompletedLessons = filteredStats.Sum(s => s.CompletedLessons);

        return filteredTotalLessons > 0 ? ((double)filteredCompletedLessons / filteredTotalLessons * 100).ToString("F1") + "%" : "N/A";
    }

    private int GetFilteredLessonsCount()
    {
        return FilteredClassSubjectStatistics.Sum(s => s.TotalLessons);
    }

    private int GetFilteredClassesCount()
    {
        return FilteredClassSubjectStatistics.Select(s => s.ClassID).Distinct().Count();
    }

    private int GetFilteredSubjectsCount()
    {
        return FilteredClassSubjectStatistics.Select(s => s.SubjectID).Distinct().Count();
    }

    protected override async Task OnInitializedAsync()
    {
        await EnrollmentService.GetEnrollments();
        await TeacherService.GetTeachers();
        await SubjectService.GetSubjects();
        await StudentService.GetStudents();
        await ClassService.GetClasses();
        await AttendanceService.GetAttendances();
        CalculateStatistics();
        isLoading = false;
    }

    private void CalculateStatistics()
    {
        var groupedEnrollments = EnrollmentService.Enrollments.GroupBy(e => new { e.ClassID, e.SubjectID })
        .Select(g => new ClassSubjectStatistic
            {
                ClassID = g.Key.ClassID,
                SubjectID = g.Key.SubjectID,
                TotalLessons = g.Count(),
                CompletedLessons = g.Count(e => !string.IsNullOrEmpty(e.Description))
            }).ToList();

        foreach(var stat in groupedEnrollments)
        {
            stat.CompletionRate = stat.TotalLessons > 0 ? (double)stat.CompletedLessons / stat.TotalLessons * 100 : 0;
            totalLessons += stat.TotalLessons;
            totalCompletedLessons += stat.CompletedLessons;
        }
        classSubjectStatistics = groupedEnrollments.OrderBy(s => GetClassName(s.ClassID)).ThenBy(s => GetSubjectName(s.SubjectID)).ToList();
    }

    private string GetClassName(int classId)
    {
        var classObj = ClassService.Classes.FirstOrDefault(c => c.ClassID == classId);
        return classObj != null ? classObj.ClassName : $"Class ID:{classId}";
    }

    private string GetSubjectName(int subjectId)
    {
        var subject = SubjectService.Subjects.FirstOrDefault(s => s.SubjectID == subjectId);
        return subject != null ? subject.SubjectName : $"Subject ID:{subjectId}";
    }

    private int GetSubjectTeacherId(int subjectId)
    {
        var subject = SubjectService.Subjects.FirstOrDefault(s => s.SubjectID == subjectId);
        return subject != null ? subject.TeacherID : 0;
    }

    private string GetTeacherName(int teacherId)
    {
        var teacher = TeacherService.Teachers.FirstOrDefault(t => t.TeacherID == teacherId);
        return teacher != null ? $"{teacher.LastName} {teacher.FirstName}" : $"Teacher ID: {teacherId}";
    }

    private string FormatPercentage(double percentage)
    {
        return percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    public class ClassSubjectStatistic
    {
        public int ClassID { get; set; }
        public int SubjectID { get; set; }
        public int TotalLessons { get; set; }
        public int CompletedLessons { get; set; }
        public double CompletionRate { get; set; }
    }
}
