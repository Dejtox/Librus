@page "/AdminStudents"
@inject DialogService DialogService
@inject IStudentService StudentService
@inject IUserService UserService
@attribute [Authorize(Roles = "Teacher, Admin, Assistant")]

<RadzenDataGrid @ref="StudentGrid" TItem="Student" Data="StudentService.Students" AllowFiltering="true" AllowColumnResize="true"
                FilterMode="FilterMode.Advanced" PageSize="5" AllowPaging="true" AllowSorting="true" ColumnWidth="100px"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" TItem="Teacher" AllowAlternatingRows="false" ShowPagingSummary="true"
                LogicalFilterOperator="LogicalFilterOperator.Or" FilterPopupRenderMode="PopupRenderMode.OnDemand" Sort="@(args => ResetIndex(true))" Page="@(args => ResetIndex(true))" Filter="@(args => ResetIndex(true))">
    <Columns>
        <RadzenDataGridColumn Title="No." TItem="Student" Sortable=false Filterable=false>
            <Template>
                @{
                    var pageSize = Math.Min(StudentGrid.PageSize, StudentGrid.View.Count());
                }
                <RenderOnceComponent CanRender=@(!(index >= pageSize))>
                    @{
                        ResetIndex(index >= pageSize);
                    }
                    @((StudentGrid.CurrentPage * pageSize) + index++ + 1)
                </RenderOnceComponent>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Name" TItem="Student" Property="FullName" />
        <RadzenDataGridColumn Title="Address" TItem="Student" Property="Address" />
        <RadzenDataGridColumn Title="Pesel" TItem="Student" Property="Pesel" />
        <RadzenDataGridColumn Title="Additional Language" TItem="Student" Property="Additional_Language" />
        <RadzenDataGridColumn Title="Login" TItem="Student" Property="User.Login" />
        <RadzenDataGridColumn Title="Password" TItem="Student" Property="User.PasswordHash" />
        <RadzenDataGridColumn Title="Class" TItem="Student" Property="Class.ClassName" />
        <RadzenDataGridColumn Title="Parent" TItem="Student" Property="Parent.FullName" />
        <RadzenDataGridColumn Title="Options" TItem="Student">
            <Template Context="Student">
                <div class="options" style="padding:3px;">
                    <button type="button" class="icon-button" onclick="@(()=>Edit(Student.StudentID))">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="icon-button" onclick="@(()=>Delete(Student.StudentID,Student.User.UserID))">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<div class="center search-margin">
    <button class="trip-add-button" @onclick="AddStudent">Add student</button>
</div>

@code {
    RadzenDataGrid<Student> StudentGrid;
    int index;
    void ResetIndex(bool shouldReset)
    {
        if (shouldReset)
        {
            index = 0;
        }
    }
    //filtercleared

    protected override async Task OnInitializedAsync()
    {
        await StudentService.GetStudents();
    }
    private async Task Edit(int id)
    {
        await DialogService.OpenAsync<AddEditStudentModal>("Edit student",
            new Dictionary<string, object>() { { "ID", id } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 40%;border-radius: 20px;height: 40%;"
                });
    }
    private async Task Delete(int studentID, int userID)
    {
        var result = await DialogService.Confirm("Are you sure?", "Confirmation", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (result.HasValue && result.Value)
        {
            
            await UserService.DeleteUser(userID);
            await StudentService.DeleteStudent(studentID);
        }
    }
    private async Task AddStudent()
    {
        await DialogService.OpenAsync<AddEditStudentModal>("Add student",
            null,
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 40%;border-radius: 20px;height: 40%;"
                });
    }
}
