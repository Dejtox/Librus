@page "/AdminTeachers"
@inject IUserService UserService
@inject ITeacherService TeacherService
@inject DialogService DialogService
@attribute [Authorize(Roles = "Teacher, Admin, Assistant")]

<RadzenDataGrid @ref="TeacherGrid" TItem="Teacher" Data="TeacherService.Teachers" AllowFiltering="true" AllowColumnResize="true"
FilterMode="FilterMode.Advanced" PageSize="5" AllowPaging="true" AllowSorting="true" ColumnWidth="100px"
FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" TItem="Teacher" AllowAlternatingRows="false" ShowPagingSummary="true" 
LogicalFilterOperator="LogicalFilterOperator.Or" FilterPopupRenderMode="PopupRenderMode.OnDemand" Sort="@(args => ResetIndex(true))" Page="@(args => ResetIndex(true))" Filter="@(args => ResetIndex(true))">
    <Columns>
        <RadzenDataGridColumn Title="No." TItem="Teacher" Sortable=false Filterable=false>
            <Template>
                @{
                    var pageSize = Math.Min(TeacherGrid.PageSize, TeacherGrid.View.Count());
                }
                <RenderOnceComponent CanRender=@(!(index >= pageSize))>
                    @{
                        ResetIndex(index >= pageSize);
                    }
                    @((TeacherGrid.CurrentPage * pageSize) + index++ + 1)
                </RenderOnceComponent>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Name" TItem="Teacher" Property="Name"/>
        <RadzenDataGridColumn Title="Phone Number" TItem="Teacher" Property="PhoneNumber"/>
        <RadzenDataGridColumn Title="Email" TItem="Teacher" Property="Email"/>
        <RadzenDataGridColumn Title="Login" TItem="Teacher" Property="User.Login" />
        <RadzenDataGridColumn Title="Password" TItem="Teacher" Property="User.PasswordHash" />
        <RadzenDataGridColumn Title="Roles" TItem="Teacher" Property="User.Roless"/>
        <RadzenDataGridColumn Title="Options" TItem="Teacher">
            <Template Context="Teacher">
                <div class="options" style="padding:3px;">
                    <button type="button" class="icon-button" onclick="@(()=>Edit(Teacher.TeacherID))">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="icon-button" onclick="@(()=>Delete(Teacher.TeacherID,Teacher.User.UserID))">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<div class="center search-margin">
    <button class="trip-add-button" @onclick="AddTeacher">Add teacher</button>
</div>

@code {
    RadzenDataGrid<Teacher> TeacherGrid;
    int index;
    void ResetIndex(bool shouldReset)
    {
        if (shouldReset)
        {
            index = 0;
        }
    }
    //filtercleared

    protected override async Task OnInitializedAsync()
    {
        await TeacherService.GetTeachers();
    }
    private async Task Edit(int id)
    {
        await DialogService.OpenAsync<AddEditTeacherModal>("Edit teacher",
            new Dictionary<string, object>() { { "ID", id } },
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 30%;border-radius: 20px;height: 40%;"
                });
    }
    private async Task Delete(int teacherID,int userID)
    {
        var result = await DialogService.Confirm("Are you sure?", "Confirmation", new ConfirmOptions{OkButtonText="Yes",CancelButtonText="No"});
        if (result.HasValue && result.Value)
        {
            await UserService.DeleteUser(userID);
            await TeacherService.DeleteTeacher(teacherID);
        }
    }
    private async Task AddTeacher()
    {
        await DialogService.OpenAsync<AddEditTeacherModal>("Add teacher",
            null,
            new DialogOptions()
                {
                    CloseDialogOnOverlayClick = true,
                    Draggable = true,
                    ShowClose = false,
                    Style = "width: 30%;border-radius: 20px;height: 40%;"
                });
    }
}
