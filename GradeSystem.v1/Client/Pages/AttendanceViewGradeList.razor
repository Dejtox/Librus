@page "/attendanceviewgradelist"
@using System.Security.Claims
@inject IClassService ClassService
@inject ITeacherService TeacherService
@inject IStudentService StudentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="Atableborder">
    <div class="Astudentinfo">
        <div class="Astudentname">
            <select value="@selectedClassId" @onchange="HandleClassChange" class="grade-select">
                <option value="0">Select Grade</option>
                @if (teacherClasses != null)
                {
                    @foreach (var classItem in teacherClasses)
                    {
                        <option value="@classItem.ClassID">@classItem.ClassName</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (selectedClassId > 0 && classStudents != null)
    {
        <div class="studentlisttable">
            <div class="studentlisttableheader">
                <div class="studentatnumberhead">No.</div>
                <div class="studentatnamehead">Name</div>
                <div></div>
            </div>
            <div class="studentlisttablelist">
                @if (classStudents.Any())
                {
                    @for (int i = 0; i < classStudents.Count; i++)
                    {
                        var student = classStudents[i];
                        var index = i+1;

                        <div class="studentatrow">
                            <div class="studentatnumber">@index</div>
                            <div class="studentatname">@student.FirstName @student.LastName</div>
                            <div class="showattendance">
                                <button @onclick="() => ShowAttendance(student.StudentID)" class="showattendancebutton">Show Attendance</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="nostudents">No students found in this grade.</div>
                }
            </div>
        </div>
    }
</div>




@code {
    private List<Student> classStudents = new List<Student>();
    private List<Class> teacherClasses = new List<Class>();
    private int currentTeacherId;
    private int selectedClassId = 0;
    private int userIDFromEmail = 0;
    Teacher teacher = new Teacher();

    protected override async Task OnInitializedAsync()
    {
        await ClassService.GetClasses();
        await TeacherService.GetTeachers();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var emailClaim = user.FindFirst(ClaimTypes.Email) ??
                            user.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress");

            if (emailClaim != null && int.TryParse(emailClaim.Value, out int userId))
            {
                userIDFromEmail = userId;

                teacher = await TeacherService.GetTeacherByID(userIDFromEmail);

                if (teacher != null)
                {
                    teacherClasses = ClassService.Classes
                        .Where(c => c.TeacherID == teacher.TeacherID)
                        .ToList();
                }
            }
        }
    }

    private async Task HandleClassChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out int classId))
        {
            selectedClassId = classId;
            await LoadStudents();
        }
    }

    private async Task LoadStudents()
    {
        if (selectedClassId > 0)
        {
            if (StudentService.Students == null || !StudentService.Students.Any())
            {
                await StudentService.GetStudents();
            }

            classStudents = StudentService.Students
                .Where(s => s.ClassID == selectedClassId)
                .ToList();
        }
        else
        {
            classStudents.Clear();
        }
        StateHasChanged();
    }

    void ShowAttendance(int StudentID)
    {
        // NavigationManager.NavigateTo($"/AttendanceViewSingleStudent/{StudentID}");
        NavigationManager.NavigateTo($"/AttendanceViewSingleStudent/{StudentID}");
    }

    protected async Task OnSelectedClassChanged()
    {
        await LoadStudents();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (selectedClassId > 0)
        {
            await LoadStudents();
        }
    }
}
