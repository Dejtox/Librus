@page "/attendanceviewgradelist"
@inject ITeacherService TeacherService

<div class="Atableborder">
    <div class="Astudentinfo">
        <div class="Astudentname">Grade (5)</div>
    </div>
    <div class="studentlisttable">
        <div class="studentlisttableheader">
            <div class="studentatnumberhead">No.</div>
            <div class="studentatnamehead">Name</div>
            <div></div>
        </div>
        <div class="studentlisttablelist">
            @for(int i=1; i<20; i++)
            {
                <div class="studentatrow">
                    <div class="studentatnumber">1</div>
                    <div class="studentatname">John</div>
                    <div class="showattendance">
                        <button class="showattendancebutton">Show Attendance</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>




@code {

    int ID;
    int selectedchildID;
    string Roles;
    Student studentselected;
    Teacher teacher;

    protected override async Task OnInitializedAsync()
    {
        await TeacherService.GetTeachers();
    }


    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        };

        if (Roles == "Teacher")
        {
            foreach (var teacherpom in TeacherService.Teachers)
            {
                if (teacherpom.TeacherID == ID)
                {
                    teacher = teacherpom;
                }
            }

        }
    }
}
