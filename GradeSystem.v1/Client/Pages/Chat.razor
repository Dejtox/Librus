<style>
    .chat-app {
        display: flex;
        height: 600px;
        border: 1px solid #ccc;
        font-family: Arial, sans-serif;
    }

    .chat-sidebar {
        width: 250px;
        border-right: 1px solid #ccc;
        background-color: #f8f8f8;
        display: flex;
        flex-direction: column;
    }

        .chat-sidebar input {
            margin: 10px;
            padding: 8px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

    .user-list {
        list-style: none;
        padding: 0;
        margin: 0;
        overflow-y: auto;
    }

        .user-list li {
            padding: 10px;
            cursor: pointer;
        }

            .user-list li.active, .user-list li:hover {
                background-color: #e0e0e0;
            }

    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: #fff;
    }

    .chat-header {
        padding: 10px;
        background-color: #f0f0f0;
        border-bottom: 1px solid #ccc;
        font-weight: bold;
    }

    .chat-messages {
        flex: 1;
        padding: 10px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .message {
        max-width: 60%;
        padding: 8px 12px;
        border-radius: 16px;
        font-size: 14px;
    }

        .message.sent {
            align-self: flex-end;
            background-color: #dcf8c6;
        }

        .message.received {
            align-self: flex-start;
            background-color: #e5e5ea;
        }

    .meta {
        font-size: 10px;
        color: gray;
        text-align: right;
    }

    .chat-input {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ccc;
    }

        .chat-input input {
            flex: 1;
            padding: 8px;
            border-radius: 20px;
            border: 1px solid #ccc;
            margin-right: 8px;
        }

        .chat-input button {
            padding: 8px 16px;
            border: none;
            border-radius: 20px;
            background-color: #0b93f6;
            color: white;
            cursor: pointer;
        }

            .chat-input button:hover {
                background-color: #007ad9;
            }

    .no-chat-selected {
        margin: auto;
        font-size: 18px;
        color: #888;
    }

</style>



@page "/chat"
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authStateProvider
@inject IChatMessageService chatMessageService
@inject ITeacherService TeacherService
@inject IParentService ParentService
@inject IStudentService StudentService

<h3>Chat</h3>

<div class="chat-app">
    <div class="chat-sidebar">
        <input type="text" placeholder="Search..." @bind="searchText" @bind:event="oninput" />
        <ul class="user-list">
            @foreach (var user in FilteredUsers)
            {
                <li @onclick="@(async _ => await SelectUser(user))" class="@(user.UserID == receiverID ? "active" : "")">
                    <span>@user.FullName</span>
                </li>
            }
        </ul>
    </div>

    <div class="chat-main">
        @if (receiverID != 0)
        {
            <div class="chat-header">
                Chat with @selectedUser.FullName
            </div>

            <div class="chat-messages">
                @foreach (var message in messages)
                {
                    <div class="message @(message.SenderID == senderID ? "sent" : "received")">
                        <div>@message.Content</div>
                        <div class="meta">@message.SentAt.ToShortTimeString()</div>
                    </div>
                }
            </div>

            <div class="chat-input">
                <input type="text" @bind="newMessage" @bind:event="oninput" placeholder="Type a message..." />
                <button @onclick="@(async _=>await Send())">Send</button>
            </div>
        }
        else
        {
            <div class="no-chat-selected">
                Select a user to start chatting
            </div>
        }
    </div>
</div>

@code {
    private HubConnection hubConnection;
    private List<ChatMessage> messages = new List<ChatMessage>();
    private int senderID = 0;
    private int receiverID = 0;
    private ChatUser selectedUser;
    private string newMessage = "";
    private string searchText = "";
    private List<ChatUser> chatUsers = new List<ChatUser>();

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }


    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                senderID = Int32.Parse(claim.Value);
            }
        }        
    }
    protected override async Task OnInitializedAsync()
    {
        await TeacherService.GetTeachers();
        await ParentService.GetParents();
        await StudentService.GetStudents();
        await GetClaimsGetID();
        chatUsers=TeacherService.Teachers
            .Select(t => new ChatUser { UserID = t.UserID, FullName = t.Name })
            .Concat(ParentService.Parents.Select(p => new ChatUser { UserID = p.UserID, FullName = p.FullName }))
            .Concat(StudentService.Students.Select(s => new ChatUser { UserID = s.UserID, FullName = s.Name }))
            .ToList();
        hubConnection = new HubConnectionBuilder()
        .WithUrl(navigationManager.ToAbsoluteUri("/chathub"), options =>
        {
            options.AccessTokenProvider = async () =>
            {
                var customAuthStateprovider = (CustomAuthenticationStateProvider)authStateProvider;
                return await customAuthStateprovider.GetToken();
            };
        })
        .Build();
        hubConnection.On<ChatMessage>("ReceiveMessage", (message) =>
        {
            messages.Add(message);
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }
    private IEnumerable<ChatUser> FilteredUsers =>
        chatUsers.Where(u => string.IsNullOrWhiteSpace(searchText) || u.FullName.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private async Task SelectUser(ChatUser user)
    {
        receiverID = user.UserID;
        selectedUser = user;
        messages = await chatMessageService.GetChatMessages(senderID, receiverID);
    }

    private async Task Send()
    {
        if (!string.IsNullOrWhiteSpace(newMessage))
        {
            var message = new ChatMessage
            {

                SenderID = senderID,
                ReceiverID = receiverID,
                Content = newMessage,
                SentAt = DateTime.Now
            };
            await chatMessageService.CreateChatMessage(message);
            await hubConnection.SendAsync("SendMessage", message);
            messages.Add(message);
            await InvokeAsync(StateHasChanged);
            newMessage = string.Empty;            
        }
    }   
}

