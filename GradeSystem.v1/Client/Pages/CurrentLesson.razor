@page "/CurrentLesson"
@using System.Security.Claims
@inject IStudentService StudentService
@inject IGradeService GradeService
@inject ISubjectService SubjectService
@inject IUserService UserService
@inject ITeacherService TeacherService
@inject IJSRuntime js
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using System.Timers
@inject DialogService DialogService

<div class="CLcontainer">
    <div class="CLleftcontainer">
        <button class="CLstartlesson" onclick="@StartLesson" hidden="@hidden">Start Lesson</button>
        <div class="CLbutcontainer">
            <div class="CLbuttoncontainerrow">
                <button class="CLbutton" style="background-color: rgb(91,208,145)" @onclick="@(()=>AddAttendances(10))">
                    <div class="gg-check-r"></div>
                    <div class="CLbuttonname">Attendance</div>
                </button>

                <button class="CLbutton" style="background-color: rgb(248,148,56)" @onclick="@(()=>AddExam(2,1))">
                    <div class="gg-check-o"></div>
                    <div class="CLbuttonname">Tests</div>
                </button>
            </div>

            <div class="CLbuttoncontainerrow">
                <button class="CLbutton" style="background-color: rgb(91,103,208)" @onclick="@(()=>NavigationManager.NavigateTo("/materials"))">
                    <div class="gg-check-r"></div>
                    <div class="CLbuttonname">Materials</div>
                </button>

                <button class="CLbutton" style="background-color: rgb(230,95,95)" @onclick="@(()=>NavigationManager.NavigateTo("/notes"))">
                    <div class="gg-check-o"></div>
                    <div class="CLbuttonname">Note</div>
                </button>
            </div>
        </div>

        <div style="margin-top:5%;">
            <div class="CLbutton" style="background-color:rgb(248,148,56)">
                <div>@FormatTime(TimeLeft)</div>
            </div>
        </div>
    </div>

    <div class="CLrightcontainer">
        <div class="Ttableborder">
            <div class="Tstudentinfo">

                <div class="Tstudentname">Grade (class)</div>
                @if (teacher.TeacherID != null)
                {
                    <div class="Tstudentclass">Subject (subject)</div>
                }


            </div>
            <div class="Tgradestable">
                <div class="Tgradeheader">
                    <button class="Taddgrade"><div class="circle-plus"></div></button>
                    <div class="Tnumber">No.</div>
                    <div class="Tname">Name</div>
                    <div class="Tterm">
                        <div class="Ttop">Term 1</div>
                        <div class="Tbot">
                            <div class="headergrade">Grades</div>
                            <div class="gst">Av.</div>
                            <div class="gst">I</div>
                        </div>
                    </div>
                    <div class="Tterm">
                        <div class="Ttop">Term 2</div>
                        <div class="Tbot">
                            <div class="headergrade">Grades</div>
                            <div class="gst">Av.</div>
                            <div class="gst">II</div>
                        </div>
                    </div>
                    <div class="Teoy">
                        <div class="Ttop">EOY</div>
                        <div class="Tbot">av.</div>
                    </div>

                </div>
                <div class="Tgradesdisplay">
                    @for (int i = 1; i < 21; i++)
                    {
                        <div class="Tgraderow">
                            <button class="Taddgrade Taddgrade--d"><div class="circle-plus"></div></button>
                            <div class="Tnumber Tnumber--d">1</div>
                            <div class="Tname">Name</div>
                            <div class="Tgrade">
                                <div class="Tgradevalue">2</div>
                                <div style="width: 15%; border-left: solid 1px #DBDBDB">2</div>
                                <div style="width: 15%; border-left: solid 1px #DBDBDB">2</div>
                            </div>
                            <div class="Tgrade">
                                <div class="Tgradevalue">3</div>
                                <div style="width: 15%; border-left: solid 1px #DBDBDB">3</div>
                                <div style="width: 15%; border-left: solid 1px #DBDBDB">3</div>
                            </div>
                            <div class="Tfinalgrade">2.5</div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

</div>


@code {
    [Parameter]
    public int? ID { get; set; }

    string color = "";
    bool hidden = false;
    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }
    private IEnumerable<Claim> _claims = Enumerable.Empty<Claim>();

    Teacher teacher = new Teacher();
    User user = new User();

    private Timer? timer;
    private TimeSpan TimeLeft = TimeSpan.FromMinutes(45); 
    string btnText = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        btnText = ID == null ? "Save New Parent" : "Update Parent";
        await StudentService.GetStudents();
        await GradeService.GetGrades();
        await TeacherService.GetTeachers();
        await SubjectService.GetSubjects();
        await GetClaimsGetID();
        //teacher = await TeacherService.GetTeacherByID((int)ID);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ID == null)
        {
            await TeacherService.GetTeachers();
        }
        else
        {
            teacher = await TeacherService.GetTeacherByID((int)ID);
            user = await UserService.GetUserByID(teacher.UserID);
        }

        await GetClaimsGetID();
        await base.OnParametersSetAsync();
    }

    int IDU;
    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                IDU = Int32.Parse(claim.Value);
            }
        };
    }

    void ShowGrade(int id)
    {
        NavigationManager.NavigateTo($"grade/{id}");
    }
    void CreateGrade()
    {
        NavigationManager.NavigateTo("/grade");
    }
    void StartLesson()
    {
        if (timer == null)
        {
            timer = new Timer(1000); // 1 second interval
            timer.Elapsed += TimerElapsed;
            timer.Start();
            hidden = true;
        }
    }
    private void TimerElapsed(object sender, ElapsedEventArgs e)
    {
        if (TimeLeft.TotalSeconds > 0)
        {
            TimeLeft = TimeLeft.Subtract(TimeSpan.FromSeconds(1));
            InvokeAsync(StateHasChanged); // Update UI
        }
        else
        {
            timer?.Stop();
            timer?.Dispose();
            timer = null;

        }
    }
    private string FormatTime(TimeSpan time)
    {
        return time.ToString(@"mm\:ss");
    }
    public async Task AddExam(int SubjectID,int ClassID)
    {
        await DialogService.OpenAsync<AddEditExamModal>("Add exam",
            new Dictionary<string, object>() { { "SubjectID", SubjectID },{"ClassID",ClassID } },
            new DialogOptions()
            {
                CloseDialogOnOverlayClick = true,
                Draggable = true,
                ShowClose = false,
                Style = "width: 40%;border-radius: 20px;height: 40%;"
            });
    }
    public async Task AddAttendances(int id)
    {
        await DialogService.OpenAsync<EnrollmentSummaryModal>("Enrollment summary",
            new Dictionary<string, object>() { { "ID", id } },
            new DialogOptions()
            {
                CloseDialogOnOverlayClick = true,
                Draggable = true,
                ShowClose = false,
                Style = "width: 40%;border-radius: 20px;height: 40%;"
            });
    }
}