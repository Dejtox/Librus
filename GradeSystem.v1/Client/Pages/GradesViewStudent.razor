@page "/gradesviewstudent"
@page "/gradesviewstudent/{id:int}"
@using System.Security.Claims
@inject IStudentService StudentService
@inject IParentService ParentService
@inject IGradeService GradeService
@inject ISubjectService SubjectService
@inject IUserService UserService
@inject ITeacherService TeacherService
@inject IGradeNumberService GradeNumberService
@inject IEnrollmentService EnrollmentService
@inject IJSRuntime js
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationMenager
@attribute [Authorize(Roles = "Student, Admin, Parent")]

<div class="tableborder">
    <div class="studentinfo">

        <div class="studentname">Student (@student.FirstName @student.LastName)</div>
        @if(student.Class != null)
        {
            <div class="studentclass">Grade (@student.Class.ClassName)</div>
        }

    </div>
    <div class="gradestable">
        <div class="gradeheader">
            <div class="gradesubject">Subject</div>
            <div class="term" >
                <div class="top">Term 1</div>
                <div class="bot">
                    <div class="headergrade">Grades</div>
                    <div class="gst">Av.</div>
                    <div class="gst">II</div>
                </div>
            </div>
            <div class="term">
                <div class="top">Term 2</div>
                <div class="bot">
                    <div class="headergrade">Grades</div>
                    <div class="gst">Av.</div>
                    <div class="gst">II</div>    
                </div>
            </div>
            <div class="eoy">
                <div class="top">EOY</div> 
                <div class="bot">
                    <div class="gstost">Av.</div>   
                    <div class="gstost">III</div>   
                </div>
            </div>

        </div>
        <div class="gradesdisplay">
            @foreach (var subject in studentSubjects)
            {
                <div class="graderow">
                    <div class="subjectgrade">@subject.SubjectName</div>
                    <div class="grade">
                        @foreach (var grade in GradeService.Grades.Where(g => g.Semester == 1 && g.StudentID == student.StudentID))
                        {
                            if(subject.SubjectID == grade.SubjectID)
                            {
                                if(IDU == grade.StudentID)
                                {
                                    var gradeType = GradeNumberService.GradeTypes.FirstOrDefault(gt => gt.GradeTypeId == grade.GradeTypeId);
                                    color = gradeType?.color ?? "grey";
                                    <p @onclick="() => ShowGrade(grade.GradeID)" style="background-color:@color; cursor: pointer;" class="d-inline-flex m-1 p-1">@grade.Gradenumber.GradeName</p>
                                }
                            }
                        }
                    </div>

                    <div class="gradeAverage">
                        @{
                            var term1Grades = GradeService.Grades.Where(g => g.SubjectID == subject.SubjectID && g.StudentID == student.StudentID && g.Semester == 1).ToList();
                            var term1Average = WeightAverageCalc(term1Grades);

                            <p style="background-color:lightgrey;" class="d-inline-flex m-1 p-1">@(term1Average > 0 ? term1Average.ToString() : "-")</p>
                        }
                    </div>

                    <div class="grade">
                        @foreach (var grade in GradeService.Grades.Where(g => g.Semester == 2 && g.StudentID == student.StudentID))
                        {
                            if (subject.SubjectID == grade.SubjectID)
                            {
                                if (IDU == grade.StudentID)
                                {
                                    var gradeType = GradeNumberService.GradeTypes.FirstOrDefault(gt => gt.GradeTypeId == grade.GradeTypeId);
                                    color = gradeType?.color ?? "grey";
                                    <p @onclick="() => ShowGrade(grade.GradeID)" style="background-color:@color; cursor: pointer;" class="d-inline-flex m-1 p-1">@grade.Gradenumber.GradeName</p>
                                }
                            }
                        }
                    </div>

                    <div class="gradeAverage">
                        @{
                            var term2Grades = GradeService.Grades.Where(g => g.SubjectID == subject.SubjectID && g.StudentID == student.StudentID && g.Semester == 2).ToList();
                            var term2Average = WeightAverageCalc(term2Grades);

                            <p style="background-color:lightgrey;" class="d-inline-flex m-1 p-1">@(term2Average > 0 ? term2Average.ToString() : "-")</p>
                        }
                    </div>

                    <div class="finalgrade">
                        @{
                            var studentSubjectGrades = GradeService.Grades.Where(g => g.SubjectID == subject.SubjectID && g.StudentID == student.StudentID).ToList();
                            var totalAverage = WeightAverageCalc(studentSubjectGrades);

                            <p style="background-color:lightgrey;" class="d-inline-flex m-1 p-1">@(totalAverage > 0 ? totalAverage.ToString() : "-")</p>
                        }
                    </div>
                    @* <div> *@
                    @*     @{ *@
                    @*         if (totalAverage > 0) *@
                    @*         { *@
                    @*             var proposedGrade = ProposedGradeCalc(totalAverage); *@
                    @*             <p style="background-color:lightgrey;" class="d-inline-flex m-1 p-1">(@proposedGrade)</p> *@
                    @*         } *@
                    @*         else *@
                    @*         { *@
                    @*             <p style="background-color:lightgrey;" class="d-inline-flex m-1 p-1">(-)</p> *@
                    @*         } *@
                    @*     } *@
                    @* </div> *@
                </div>
            }
        </div>
    </div>
</div>
@code {
    [Parameter]
    public int? ID { get; set; }

    string color = "";

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }
    private IEnumerable<Claim> _claims = Enumerable.Empty<Claim>();

    Student student = new Student();
    User user = new User();
    List<Subject> studentSubjects = new List<Subject>();
    List<Enrollment> studentEnrollments = new List<Enrollment>();

    string btnText = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        btnText = ID == null ? "Save New Parent" : "Update Parent";
        await StudentService.GetStudents();
        await ParentService.GetParents();
        await GradeService.GetGrades();
        await GradeNumberService.GetGradeTypes();
        await GradeNumberService.GetGradeNumbers();
        await TeacherService.GetTeachers();
        await SubjectService.GetSubjects();
        await GetClaimsGetID();
        student = await StudentService.GetStudentById((int)IDU);
        studentEnrollments = await EnrollmentService.GetEnrollmentsByClassID(student.ClassID);
        // await EnrollmentService.GetEnrollments();
        LoadStudentSubjects();
    }

    private void LoadStudentSubjects()
    {
        if (student != null && student.ClassID > 0)
        {
            var subjectIds = studentEnrollments
                .Where(e => e.ClassID == student.ClassID)
                .Select(e => e.SubjectID)
                .Distinct()
                .ToList();

            studentSubjects = SubjectService.Subjects
                .Where(s => subjectIds.Contains(s.SubjectID))
                .ToList();
        }
        else
        {
            studentSubjects = new List<Subject>();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ID == null)
        {
            await StudentService.GetParents();
            await StudentService.GetClasses();
        }
        else
        {
            student = await StudentService.GetStudentById((int)ID);
            user = await UserService.GetUserByID(student.UserID);

            if (student != null && student.ClassID > 0)
            {
                studentEnrollments = await EnrollmentService.GetEnrollmentsByClassID(student.ClassID);
                // await EnrollmentService.GetEnrollments();
                LoadStudentSubjects();
            }
        }

        await GetClaimsGetID();
        await base.OnParametersSetAsync();
    }

    int IDU;
    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                IDU = Int32.Parse(claim.Value);
            }
        };
    }

    void ShowGrade(int id)
    {
        NavigationMenager.NavigateTo($"grade/{id}");
    }
    void CreateGrade()
    {
        NavigationMenager.NavigateTo("/grade");
    }

    private double WeightAverageCalc(List<Grade> grades)
    {
        if (!grades.Any())
        {
            return 0;
        }

        double weightedSum = 0;
        double totalWeight = 0;

        foreach (var grade in grades)
        {
            var gradeNumber = GradeNumberService.GradeNumbers.FirstOrDefault(gn => gn.GradeNumberID == grade.GradeNumberID);

            if (gradeNumber != null)
            {
                double gradeValue = gradeNumber.gradenumber;
                double weight = grade.GradeWeight;

                weightedSum += gradeValue * weight;
                totalWeight += weight;
            }
        }

        return totalWeight > 0 ? Math.Round(weightedSum / totalWeight, 2) : 0;
    }

