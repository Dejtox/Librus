@page "/LibraryViev"
@inject IBookService BookService
@inject IStudentService StudentService
@inject IBookServiceSupport BookServiceSupport
@inject IBookTypeService BookTypeService
@inject NavigationManager NavigationManager
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Text;
@using System.Text.RegularExpressions;

<div class="mb-4 d-flex flex-wrap gap-3 align-items-center">
    <div class="input-group w-auto flex-fill" style="max-width: 400px;">
        <span class="input-group-text">
            <i class="bi bi-search"></i>
        </span>
        <input type="text" class="form-control" placeholder="Search by title or author..." @oninput="FillTable" />
    </div>

    <div class="form-check ms-2">
        <input type="checkbox" class="form-check-input" id="availableCheckbox" @bind-value="isawailable" @onclick="DoUpdateList" />
        <label class="form-check-label" for="availableCheckbox">
            Show only available books
        </label>
    </div>

    <button class="btn btn-warning ms-auto" @onclick="OpenAddBookPopup">
        <i class="bi bi-plus-circle me-1"></i> Add New Book
    </button>
</div>

<div style="max-height: 600px; overflow-y: auto;" class="rounded border p-0 bg-white shadow-sm">
    <table class="table table-bordered custom-table mb-0">
        <thead class="table-dark sticky-top" style="top: 0;">
            <tr>
                <th></th>
                <th>Title</th>
                <th>Author</th>
                <th>Edition</th>
                <th>Amount</th>
                <th>Image</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var segment in segments)
            {
                string imgurl1 = "Img/dubk.jpg";
                <tr>
                    <td>
                        <button class="btn arrow-toggle" @onclick="() => ToggleCollapse(segment.Id)">
                            <svg class="arrow @(segment.IsCollapsed ? "" : "rotate")" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M6.646 4.646a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L9.293 8 6.646 5.354a.5.5 0 0 1 0-.708z" />
                            </svg>
                        </button>
                    </td>
                    <td>@segment.bookType.Title</td>
                    <td>@segment.bookType.Author</td>
                    <td>@segment.bookType.Edition</td>
                    <td>@segment.bookType.AmountOfBooks</td>
                    <td>
                        <img src="@imgurl1" alt="Image" style="max-width: 80px;" />
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="(() => AddBook(segment.bookType))">Edit</button>
                    </td>
                </tr>

                <tr class="@GetCollapseClass(segment.Id)">
                    <td colspan="7">
                        <div class="p-3 bg-light rounded">
                            <h5>Book Copies</h5>
                            <table class="table table-sm table-striped text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>QR Code</th>
                                        <th>Generate QR</th>
                                        <th>Status</th>
                                        <th>Change Status</th>
                                        <th>Borrow</th>
                                        <th>Borrowing/Booking Date</th>
                                        <th>End Date</th>
                                        <th>Student</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in segment.bookType.Books)
                                    {
                                        <tr>
                                            <td>@book.QRCode</td>

                                            <td>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="(() => ShowGenerateQrPopup(book))">
                                                    Generate
                                                </button>
                                            </td>

                                            <td>
                                                @if (book.IsBoocked)
                                                {
                                                    <span class="badge bg-info">Booked</span>
                                                }
                                                else if (book.IsBorowed)
                                                {
                                                    <span class="badge bg-danger">Borrowed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                            </td>

                                            <td>
                                                @if (book.IsBoocked || book.IsBorowed)
                                                {
                                                    <button class="btn btn-outline-success btn-sm" @onclick="(()=>ReturnToAvailable(book))">
                                                        Change
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>

                                            <!-- Borrow (akcja) -->
                                            <td>
                                                @if (!book.IsBoocked && !book.IsBorowed)
                                                {
                                                    <button class="btn btn-primary btn-sm" @onclick="(() => GoToBookBorowing(book.QRCode))">
                                                        Borrow
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>

                                            <!-- Borrowing/Booking Date -->
                                            <td>
                                                @(book.IsBoocked ? book.ReservationDate?.ToShortDateString()
                                                    : book.IsBorowed ? book.BorowingDate?.ToShortDateString()
                                                    : "—")
                                            </td>

                                            <!-- End Date -->
                                            <td>@(book.ReturnDate?.ToShortDateString() ?? "—")</td>

                                            <!-- Student -->
                                            <td>
                                                @(book.IsBoocked || book.IsBorowed
                                                    ? $"{book.Student?.FirstName} {book.Student?.LastName}"
                                                    : "—")
                                            </td>

                                            <!-- Delete -->
                                            <td>
                                                <button class="btn btn-danger btn-sm" @onclick="(() => DeleteBook(book))">Delete</button>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<BookAddEditPopup @ref="popupref"></BookAddEditPopup>
<AddBookPopup @ref="popuprefadd"></AddBookPopup>
<GenerateQrPopup @ref="popuprefqr"></GenerateQrPopup>

@code {
    void GoToBookType() => NavigationManager.NavigateTo($"AddEditBook");
    void GoToBookBorowing(int QR) => NavigationManager.NavigateTo($"/Borrow/{QR}");

    IList<BookView> BookAmount = new List<BookView>();
    private BookAddEditPopup popupref;
    private AddBookPopup popuprefadd;
    private GenerateQrPopup popuprefqr;

    async Task FillTable(ChangeEventArgs args)
    {
        btnText = args.Value.ToString();
        await DoUpdateList();
    }

    protected override async Task OnInitializedAsync()
    {
        await StudentService.GetStudents();
        await BookService.GetBooks();
        await DoUpdateList();
    }

    string bar;
    bool isawailable = false;
    bool yourbooks = false;
    string btnText = string.Empty;
    int ID;
    Student student;
    BookType booktype;
    BookType booktype2;
    string Roles;
    private List<Segmentt> segments = new List<Segmentt>();

    private class Segmentt
    {
        public int Id { get; set; }
        public bool IsCollapsed { get; set; }
        public BookType bookType { get; set; }
    }

    async Task DoUpdateList()
    {
        await BookServiceSupport.UpdateList(isawailable, btnText);
        segments.Clear();
        await CreateSegments();
    }

    async Task CreateSegments()
    {
        int i = 0;
        foreach (var booktype in BookServiceSupport.BookList)
        {
            for (int z = 0; z < booktype.Books.Count; z++)
            {
                if (booktype.Books[z].StudentId != null)
                {
                    booktype.Books[z].Student = await StudentService.GetStudentById((int)booktype.Books[z].StudentId);
                }
            }
            segments.Add(new Segmentt { Id = i, bookType = booktype, IsCollapsed = true });
            i++;
        }
    }

    private void ToggleCollapse(int segmentId)
    {
        var segment = segments.FirstOrDefault(s => s.Id == segmentId);
        if (segment != null)
        {
            segment.IsCollapsed = !segment.IsCollapsed;
        }
    }

    private string GetCollapseClass(int segmentId)
    {
        var segment = segments.FirstOrDefault(s => s.Id == segmentId);
        return segment != null && segment.IsCollapsed ? "collapse" : "collapse show";
    }

    async Task DeleteBook(Book book)
    {
        await BookService.DeleteBook(book.BookID);
        await DoUpdateList();
    }

    private void showedit(Book book) => popupref.ShowBookedit(book);
    void AddBook(BookType booktype) => showeAdd(booktype);
    void OpenAddBookPopup() => popuprefadd.ShowBookAdd();
    private void showeAdd(BookType booktype) => popuprefadd.ShowBookAdd(booktype);

    async Task ReturnToAvailable(Book book)
    {
        book.ReturnDate = null;
        book.ReservationDate = null;
        book.BorowingDate = null;
        book.Student = null;
        book.StudentId = null;
        book.IsBorowed = false;
        book.IsBoocked = false;
        await BookService.UpdateBook(book);
    }

    void ShowGenerateQrPopup(Book book)
    {
        popuprefqr.ShowQr(book);
    }
}
