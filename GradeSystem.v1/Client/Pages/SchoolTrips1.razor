@page "/school_trips1"
@inject NavigationManager navigationManager
@inject ISchoolTripService SchoolTripService
@inject DialogService DialogService

<PageTitle>School Trips</PageTitle>

<div class="content-container">
    <div class="content-header">
        <p class="page-header">Trips</p>
    </div>
    <div class="search-container">
        <div class="empty-row"></div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="search-margin">
                <RadzenLabel Text="Trip leader" Component="TripLeaderValue" Style="font-weight:bold;width:8%;font-size:17px;"/>
                <RadzenDropDown @bind-Value=@teacherID Data=@SchoolTripService.Teachers Style="width: 22%; border-radius:15px;" Name="TripLeaderValue" ValueProperty="TeacherID" TextProperty="Name" Placeholder="Search..." Change="@(()=>SearchByTeacher(teacherID))" />
            </RadzenStack>
        </div>
        <div class="black-line">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="search-margin">
                <RadzenLabel Text="Grade" Component="ClassValue" Style="font-weight:bold;width:8%;font-size:17px;" />
                <RadzenDropDown @bind-Value=@classID Data=@SchoolTripService.Classes Style="width:22%; border-radius:15px;" Name="ClassValue" ValueProperty="ClassID" TextProperty="ClassName" Placeholder="Search..." Change="@(()=>SearchByClass(classID))" />
            </RadzenStack>
        </div>
        <div class="center search-margin">
            <button class="trip-add-button" onclick="@ShowAll">Show all</button>
        </div>
    </div>
    <div class="add-container center">
        <button class="trip-add-button search-margin" style="padding: 10px 100px 10px 100px;" @onclick="@AddTrip">Add trip</button>
    </div>
    <div class="table_container">
        <RadzenDataGrid @ref="schoolTripGrid" AllowColumnResize="true" PageSize="3" AllowPaging="true" Data="filteredSchoolTrips" TItem="SchoolTrip" ShowPagingSummary="true" SelectionMode="DataGridSelectionMode.Single"
                        PagerHorizontalAlign="Radzen.HorizontalAlign.Left" AllowAlternatingRows="false"
                        Style="border-radius:15px;" RowClick="((args)=>Hello(args.Data.SchoolTripID))" @bind-Value=@selectedItems Sort="@(args => ResetIndex(true))" Page="@(args => ResetIndex(true))" Filter="@(args => ResetIndex(true))">
        <Columns>
            <RadzenDataGridColumn Title="No." TItem="SchoolTrip">
                <Template>
                    @{
                        var pageSize = Math.Min(schoolTripGrid.PageSize, schoolTripGrid.View.Count());
                    }
                    <RenderOnceComponent CanRender=@(!(index >= pageSize))>
                    @{
                        ResetIndex(index >= pageSize);
                    }
                    @((schoolTripGrid.CurrentPage * pageSize) + index++ + 1)
                    </RenderOnceComponent>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SchoolTrip.Name" Title="Trip Name" TItem="SchoolTrip"/>
            <RadzenDataGridColumn Property="SchoolTrip.Duration" Title="Duration" TItem="SchoolTrip" />
            <RadzenDataGridColumn Property="SchoolTrip.Ppl" Title="Ppl." TItem="SchoolTrip" />
            <RadzenDataGridColumn Property="SchoolTrip.Classess" Title="G." TItem="SchoolTrip" />
            <RadzenDataGridColumn Property="SchoolTrip.TripLeader.Name" Title="Trip Leader" TItem="SchoolTrip" />
            <RadzenDataGridColumn Property="SchoolTrip.AddedBy" Title="Added by" TItem="SchoolTrip" />
            <RadzenDataGridColumn Title="Options" TItem="SchoolTrip">
                <Template Context="SchoolTrip">
                     <div class="options">
                    <button type="button" class="icon-button" onclick="@(()=>Edit(SchoolTrip.SchoolTripID))">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="icon-button" onclick="@(()=>Delete(SchoolTrip.SchoolTripID))">
                        <i class="bi bi-trash"></i>
                    </button>
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </div>
</div>

@code {
    int teacherID;
    int classID;
    public List<SchoolTrip> schoolTrips { get; set; } = new List<SchoolTrip>();
    public List<SchoolTrip> filteredSchoolTrips { get; set; } = new List<SchoolTrip>();
    IList<SchoolTrip> selectedItems; //oszukane
    private int? schoolTripToDeleteId = null;

    RadzenDataGrid<SchoolTrip> schoolTripGrid;
    int index;
    void ResetIndex(bool shouldReset)
    {
        if (shouldReset)
        {
            index = 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await SchoolTripService.GetTeachers();
        await SchoolTripService.GetClasses();
        schoolTrips=await SchoolTripService.GetSchoolTripss();
        filteredSchoolTrips = schoolTrips;
    }

    private void AddTrip()
    {
        navigationManager.NavigateTo("/school_trip1");
    }

    private async void Delete(int id)
    {
        schoolTripToDeleteId = id;
        var result = await DialogService.Confirm("Are you sure?", "Confirmation", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (result.HasValue && result.Value)
        {
            await SchoolTripService.DeleteSchoolTripByID(id);
        }
        else
        {
            schoolTripToDeleteId = null;
        }
    }
    private void Edit(int id)
    {
        navigationManager.NavigateTo($"/school_trip1/{id}");
    }
    private void SearchByTeacher(int? ID)
    {
        if(ID==null)
        {
            filteredSchoolTrips = schoolTrips;
        }
        else
        {
            filteredSchoolTrips = schoolTrips.Where(st => st.TripLeaderID == ID).ToList();
            ResetIndex(true);
        }
    }
    private void SearchByClass(int? ID)
    {
        filteredSchoolTrips = schoolTrips.Where(st => st.Classes.Any(c => c.ClassID == ID)).ToList();
        ResetIndex(true);
    }
    private void Hello(int id)
    {
        if (schoolTripToDeleteId ==null)
        {
            navigationManager.NavigateTo($"/school_trip_summary/{id}");
        }
        
    }
    private void ShowAll()
    {
        filteredSchoolTrips = schoolTrips;
        ResetIndex(true);
    }
}
