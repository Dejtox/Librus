@page "/StartSchoolYear"
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<h3>StartSchoolYear</h3>
<button onclick="@AddDayOff" type="button">Add day off</button>
<button onclick="@AddEnrollments" type="button">Add enrollments</button>

@code {
    private async Task AddDayOff()
    {
        await DialogService.OpenAsync<AddDayOffModal>("Add dayoff",
            null,
            new DialogOptions()
            {
                CloseDialogOnOverlayClick = true,
                Draggable = true,
                ShowClose = false,
                Style = "width: 30%;border-radius: 20px;height: 30%;"
            });
    }
    private void AddEnrollments()
    {
        NavigationManager.NavigateTo("/AddEnrollments");
    }
}
