@page "/stdlasrarrendences"
@using System.Globalization;
@inject IStudentService StudentService
@inject IAttendanceService AttendanceService
@inject IEnrollmentService EnrollmentService
@inject IParentService ParentService
@attribute [Authorize(Roles = "Admin, Parent, Student")]

<div class="attendance-container">
    <div class="attendance-header">
        <div class="attendance-title">Attendance</div>
    </div>

    <div class="date-selector-menu">
        @if (SelectedDate.Day > 1)
        {
            <div class="date-selector-item">
                <div></div>
                <div>
                    <button type="button" class="date-nav-button" aria-label="Previous" @onclick="Lower">
                        <div class="gg-chevron-left"></div>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item">
                <div></div>
                <div>
                    <button disabled class="date-nav-button">
                        <div class="gg-chevron-left"></div>
                    </button>
                </div>
            </div>
        }

        @if (SelectedDate.Day - 3 > 0)
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(-3)))">
                <div class="date-display-button">@SelectedDate.AddDays(-3).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(-3)) ? "today-date" : "")">@(SelectedDate.Day - 3)</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        @if (SelectedDate.Day - 2 > 0)
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(-2)))">
                <div class="date-display-button">@SelectedDate.AddDays(-2).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(-2)) ? "today-date" : "")">@(SelectedDate.Day - 2)</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        @if (SelectedDate.Day - 1 > 0)
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(-1)))">
                <div class="date-display-button">@SelectedDate.AddDays(-1).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(-1)) ? "today-date" : "")">@(SelectedDate.Day - 1)</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        <!-- Currently selected date -->
        <div class="date-selector-item selected-date">
            <div class="date-display-button">@SelectedDate.ToString("ddd", CultureInfo.InvariantCulture)</div>
            <div>
                <div class="date-display-button @(IsToday(SelectedDate) ? "today-date" : "")">@SelectedDate.Day</div>
            </div>
        </div>

        @if (SelectedDate.Day + 1 <= DateTime.DaysInMonth(SelectedDate.Year, SelectedDate.Month))
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(1)))">
                <div class="date-display-button">@SelectedDate.AddDays(1).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(1)) ? "today-date" : "")">@SelectedDate.AddDays(1).Day</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        @if (SelectedDate.Day + 2 <= DateTime.DaysInMonth(SelectedDate.Year, SelectedDate.Month))
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(2)))">
                <div class="date-display-button">@SelectedDate.AddDays(2).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(2)) ? "today-date" : "")">@SelectedDate.AddDays(2).Day</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        @if (SelectedDate.Day + 3 <= DateTime.DaysInMonth(SelectedDate.Year, SelectedDate.Month))
        {
            <div class="date-selector-item" @onclick="@(() => SelectDate(SelectedDate.AddDays(3)))">
                <div class="date-display-button">@SelectedDate.AddDays(3).ToString("ddd", CultureInfo.InvariantCulture)</div>
                <div>
                    <div class="date-display-button @(IsToday(SelectedDate.AddDays(3)) ? "today-date" : "")">@SelectedDate.AddDays(3).Day</div>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item"></div>
        }

        @if (SelectedDate.Day < DateTime.DaysInMonth(SelectedDate.Year, SelectedDate.Month))
        {
            <div class="date-selector-item">
                <div></div>
                <div>
                    <button type="button" class="date-nav-button" aria-label="Next" @onclick="Higher">
                        <div class="gg-chevron-right"></div>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="date-selector-item">
                <div></div>
                <div>
                    <button disabled class="date-nav-button">
                        <div class="gg-chevron-right"></div>
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="attendance-data-container">
        <div class="attendance-list">
            @foreach (var dailyEvent in Events)
            {
                @if (dailyEvent.Enrollment.Date.Day == SelectedDate.Day)
                {
                    <div class="attendance-row">
                        <div class="subject-info">
                            <div>@dailyEvent.Enrollment.Subject.SubjectName</div>
                        </div>
                        <div class="attendance-status" style="background-color: @GetAttendanceColor(dailyEvent.Description)">
                            <div>@dailyEvent.Description</div>
                        </div>
                    </div>
                }
            }
            @if (!Events.Any(e => e.Enrollment.Date.Day == SelectedDate.Day))
            {
                <div class="no-attendance">
                    <p>No attendance records for this date.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    int ID;
    int selectedchildID;
    Student student;
    Parent parent;
    DateTime SelectedDate;
    int? Id = null;
    Teacher teacher = null;
    string Roles;
    List<Attendance> Events = new List<Attendance>();
    List<Attendance> Atdlist = new List<Attendance>();

    protected override async Task OnInitializedAsync()
    {
        SelectedDate = DateTime.Now;
        await EnrollmentService.GetEnrollments();
        await StudentService.GetStudents();
        await ParentService.GetParents();
        await AttendanceService.GetAttendances();
        await GetClaimsGetID();
        await Filllastattendeces();
        await NewDate();
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        }

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
        if (Roles == "Parent")
        {
            foreach (var studentpom in ParentService.Parents)
            {
                if (studentpom.ParentID == ID)
                {
                    parent = studentpom;
                    if (parent.LastSelectedChildId.Value != null)
                    {
                        selectedchildID = parent.LastSelectedChildId.Value;
                        student = await StudentService.GetStudentById(selectedchildID);
                    }
                }
            }
        }
    }

    private void Lower()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        StateHasChanged();
    }

    private void Higher()
    {
        SelectedDate = SelectedDate.AddDays(1);
        StateHasChanged();
    }

    private void SelectDate(DateTime newDate)
    {
        SelectedDate = newDate;
        StateHasChanged();
    }

    private string GetAttendanceColor(string description)
    {
        return description?.ToLower() switch
        {
            var desc when desc.Contains("present") => "#008000", // green
            var desc when desc.Contains("late") => "#0000FF", // blue
            var desc when desc.Contains("unexcused") => "#F08080", // lightcoral
            var desc when desc.Contains("excused") => "#FFA500", // orange
            _ => "#6c757d" // default gray
        };
    }

    private bool IsToday(DateTime date)
    {
        DateTime today = DateTime.Today;
        return date.Date == today;
    }

    async Task Filllastattendeces()
    {
        foreach (var evn in AttendanceService.Attendances)
        {
            if (evn.StudentID == student.StudentID)
            {
                Atdlist.Add(evn);
            }
        }
        Addenrolmentstoatd();
    }

    async Task Addenrolmentstoatd()
    {
        foreach (var atd in Atdlist)
        {
            foreach (var enr in EnrollmentService.Enrollments)
            {
                if (atd.EnrollmentID == enr.EnrollmentID)
                {
                    atd.Enrollment = enr;
                }
            }
        }
        await NewDate();
    }

    async Task NewDate()
    {
        Events.Clear();
        int i = 0;
        foreach (var evn in Atdlist)
        {
            if (evn.Enrollment.Date.Month == SelectedDate.Month & evn.Enrollment.Date.Year == SelectedDate.Year)
            {
                if (Events.Count != 0)
                {
                    foreach (var evnt in Events)
                    {
                        if (DateTime.Compare(evn.Enrollment.Date, evnt.Enrollment.Date) < 0)
                        {
                            Events.Insert(i, evn);
                            i = 0;
                            break;
                        }
                        else
                        {
                            i++;
                            if (Events.Count <= i)
                            {
                                Events.Add(evn);
                                i = 0;
                                break;
                            }
                        }
                    }
                }
                else
                {
                    Events.Add(evn);
                }
            }
        }
        StateHasChanged();
    }

    async Task SelectYear(ChangeEventArgs e)
    {
        int i = Convert.ToInt32(e.Value.ToString());
        SelectedDate.Year.Equals(i);
        await NewDate();
    }

    async Task SelectMonth(ChangeEventArgs e)
    {
        int month = Convert.ToInt32(e.Value.ToString());
        SelectedDate = new DateTime(SelectedDate.Year, month, 4);
        await NewDate();
    }
}