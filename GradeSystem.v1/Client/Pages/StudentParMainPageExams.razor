@page "/studentmainpageexams"
@inject IStudentService StudentService
@inject ISubjectService SubjectService
@inject IParentService ParentService
@inject IEventService EventService
@inject IExamService ExamService

<div class="EXtable">
    <div class="EXtableheader">
        <div class="EXtitle">Incoming Exams</div>
        <div class="gg-more-vertical-r"></div>
    </div>
    <div class="EXdisplay">
        @if (isLoading)
        {
            <div class="loading">Loading exams...</div>
        }
        else if (upcomingExams?.Any() == true)
        {
            @foreach (var exam in upcomingExams)
            {
                <div class="exam-item">
                    <div class="exam-subject">
                        @GetSubjectName(exam.SubjectID)
                    </div>
                    <div class="exam-description">
                        @exam.Description
                    </div>
                    <div class="exam-date">
                        @exam.Date.ToString("MMM dd, yyyy")
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-exams">No upcoming exams</div>
        }
    </div>
</div>

@code {
    int ID;
    int selectedchildID;
    Student student;
    Parent parent;
    private List<Exam> upcomingExams = new List<Exam>();
    private Student currentStudent;
    private bool isLoading = true;
    string Roles;

    protected override async Task OnInitializedAsync()
    {
        await StudentService.GetStudents();
        await ParentService.GetParents();
        await ExamService.GetExams();
        await ExamService.GetSubjects();
        await GetClaimsGetID();
        await LoadUpcomingExams();
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        }

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
        if (Roles == "Parent")
        {
            foreach (var studentpom in ParentService.Parents)
            {
                if (studentpom.ParentID == ID)
                {
                    parent = studentpom;
                    if (parent.LastSelectedChildId.Value != null)
                    {
                        selectedchildID = parent.LastSelectedChildId.Value;
                        student = await StudentService.GetStudentById(selectedchildID);

                    }
                }
            }
        }
    }

    private async Task LoadUpcomingExams()
    {
        try
        {
            isLoading = true;
            Console.WriteLine("CYCKI");

            if (student != null)
            {
                Console.Write(student);

                // Filter exams by student's class and get upcoming ones
                var today = DateTime.Today;
                upcomingExams = ExamService.Exams
                    .Where(exam => exam.ClassID == student.ClassID && exam.Date >= today)
                    .OrderBy(exam => exam.Date)
                    .Take(5)
                    .ToList();
            }
            else
            {
                Console.WriteLine("DUPA");
            }
        }
        catch (Exception ex)
        {
            // Handle error - you might want to log this or show an error message
            Console.WriteLine($"Error loading exams: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSubjectName(int subjectID)
    {
        var subject = ExamService.Subjects?.FirstOrDefault(s => s.SubjectID == subjectID);
        return subject?.SubjectName ?? "Unknown Subject";
    }
}