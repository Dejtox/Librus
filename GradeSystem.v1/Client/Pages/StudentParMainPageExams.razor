@page "/studentmainpageexams"
@inject IStudentService StudentService
@inject ISubjectService SubjectService
@inject IParentService ParentService
@inject IEventService EventService
@inject IExamService ExamService

<div class="EXtable">
    <div class="EXtableheader">
        <div class="EXtitle">Incoming Exams</div>
        <div class="gg-more-vertical-r"></div>
    </div>
    <div class="EXdisplay">
        @if (isLoading)
        {
            <div class="loading">Loading exams...</div>
        }
        else if (groupedExams?.Any() == true)
        {
            @foreach (var dateGroup in groupedExams)
            {
                <div class="date-section">
                    <div class="date-header">
                        @GetFormattedDateHeader(dateGroup.Key)
                    </div>
                    <div class="exams-list">
                        @foreach (var exam in dateGroup.Value)
                        {
                            <div class="exam-row">
                                <div class="exam-left">
                                    <div class="time-stripe" style="background-color: @GetExamColor(exam.SubjectID)">
                                        @exam.Date.ToString("HH:mm")
                                    </div>
                                </div>
                                <div class="exam-right">
                                    <div class="subject-name">
                                        @GetSubjectName(exam.SubjectID)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-exams">No upcoming exams</div>
        }
    </div>
</div>

@code {
    int ID;
    int selectedchildID;
    Student student;
    Parent parent;
    private List<Exam> upcomingExams = new List<Exam>();
    private Dictionary<DateTime, List<Exam>> groupedExams = new Dictionary<DateTime, List<Exam>>();
    private Student currentStudent;
    private bool isLoading = true;
    string Roles;

    // Color palette for different subjects
    private readonly string[] subjectColors = {
        "#3498db", "#e74c3c", "#2ecc71", "#f39c12", "#9b59b6",
        "#1abc9c", "#e67e22", "#34495e", "#e91e63", "#00bcd4"
    };

    protected override async Task OnInitializedAsync()
    {
        await StudentService.GetStudents();
        await ParentService.GetParents();
        await ExamService.GetExams();
        await SubjectService.GetSubjects();
        await GetClaimsGetID();
        await LoadUpcomingExams();
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        }

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
        if (Roles == "Parent")
        {
            foreach (var studentpom in ParentService.Parents)
            {
                if (studentpom.ParentID == ID)
                {
                    parent = studentpom;
                    if (parent.LastSelectedChildId.Value != null)
                    {
                        selectedchildID = parent.LastSelectedChildId.Value;
                        student = await StudentService.GetStudentById(selectedchildID);
                    }
                }
            }
        }
    }

    private async Task LoadUpcomingExams()
    {
        try
        {
            isLoading = true;

            if (student != null)
            {
                Console.Write(student.ClassID);

                // Filter exams by student's class and get upcoming ones
                var today = DateTime.Today;
                upcomingExams = ExamService.Exams
                    .Where(exam => exam.ClassID == student.ClassID && exam.Date >= today)
                    .OrderBy(exam => exam.Date)
                    .Take(10) // Increased to show more exams
                    .ToList();

                // Group exams by date
                groupedExams = upcomingExams
                    .GroupBy(exam => exam.Date.Date)
                    .ToDictionary(group => group.Key, group => group.OrderBy(e => e.Date).ToList());
            }
        }
        catch (Exception ex)
        {
            // Handle error - you might want to log this or show an error message
            Console.WriteLine($"Error loading exams: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSubjectName(int subjectID)
    {
        var subject = SubjectService.Subjects?.FirstOrDefault(s => s.SubjectID == subjectID);
        return subject?.SubjectName ?? "Unknown Subject";
    }

    private string GetFormattedDateHeader(DateTime date)
    {
        var dayOfWeek = date.ToString("dddd", System.Globalization.CultureInfo.CurrentCulture);
        var formattedDate = date.ToString("dd.MM");
        return $"{dayOfWeek}, {formattedDate}";
    }

    private string GetExamColor(int subjectID)
    {
        // Use subject ID to consistently assign colors
        var colorIndex = subjectID % subjectColors.Length;
        return subjectColors[colorIndex];
    }
}