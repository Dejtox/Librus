@page "/studentmainpagegrades"
@using System.Globalization;
@inject IStudentService StudentService
@inject IGradeNumberService GradeNumberService
@inject IGradeService GradeService
@inject ISubjectService SubjectService
@inject IParentService ParentService
@attribute [Authorize(Roles = "Parent, Student, Admin")]

<div class="RGtable">

    <div class="RGtableheader">
        <div class="RGtitle">Recent Grades</div>
        <div class="gg-more-vertical-r"></div>
    </div>

    <div class="RGdisplay">

        <div class="RGsubdisplay">
            @if (LastSixGrades.Count >= 1)
            {
                @foreach (var Grade in LastSixGrades)
                {
                    <div class="RGtablerow">

                        <div class="RGdata">

                            <div class="RGLeft">
                                <div class="RGdatetime">

                                    <div>@Grade.DateOfGrading.Day</div>
                                    <div>.</div>

                                    @if (Grade.DateOfGrading.Month >= 10)
                                    {
                                        <div>@Grade.DateOfGrading.Month</div>
                                    }
                                    else
                                    {
                                        <div>0</div>
                                        <div>@Grade.DateOfGrading.Month</div>
                                    }

                                </div>
                            </div>

                            <div class="RGRight">
                                <div class="RGsubject">@Grade.Subject.SubjectName</div>
                            </div>

                        </div>

                        <div class="RGgrade" style="background-color: @GetLighterGradeTypeColor(Grade.GradeTypeId); color: white;">
                            @Grade.Gradenumber.GradeName
                        </div>

                    </div>
                }
            }
            else
            {
                <div>No grades were added lately.</div>
            }
        </div>

    </div>

</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        await GradeNumberService.GetGradeNumbers();
        await ParentService.GetParents();
        await GradeService.GetGrades();
        await GradeNumberService.GetGradeTypes();
        await StudentService.GetStudents();
        await SubjectService.GetSubjects();
        await GetClaimsGetID();
        await AddGradesToRecentGrades();
    }

    List<Grade> LastSixGrades = new List<Grade>();

    async Task AddGradesToRecentGrades()
    {
        // Get all grades for the student
        var studentGrades = GradeService.Grades
            .Where(grade => grade.StudentID == student.StudentID)
            .OrderByDescending(grade => grade.DateOfGrading)
            .Take(6)
            .ToList();

        LastSixGrades = studentGrades;
    }

    private string GetLighterGradeTypeColor(int gradeTypeId)
    {
        var gradeType = GradeNumberService.GradeTypes?.FirstOrDefault(gt => gt.GradeTypeId == gradeTypeId);

        if (gradeType?.color != null)
        {
            // Convert hex color to lighter version
            string originalColor = gradeType.color;
            return ConvertToLighterColor(originalColor);
        }

        return "lightgrey";
    }

    private string ConvertToLighterColor(string colorName)
    {
        // Dictionary mapping color names to hex values
        var colorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            {"red", "#FF0000"},
            {"green", "#008000"},
            {"blue", "#0000FF"},
            {"yellow", "#FFFF00"},
            {"orange", "#FFA500"},
            {"purple", "#800080"},
            {"pink", "#FFC0CB"},
            {"brown", "#A52A2A"},
            {"gray", "#808080"},
            {"grey", "#808080"},
            {"black", "#000000"},
            {"white", "#FFFFFF"},
            {"cyan", "#00FFFF"},
            {"magenta", "#FF00FF"},
            {"lime", "#00FF00"},
            {"maroon", "#800000"},
            {"navy", "#000080"},
            {"olive", "#808000"},
            {"teal", "#008080"},
            {"silver", "#C0C0C0"},
            {"gold", "#FFD700"},
            {"indigo", "#4B0082"},
            {"violet", "#8A2BE2"}
        };

        // Try to get hex value from color name
        string hexColor;
        if (colorMap.ContainsKey(colorName))
        {
            hexColor = colorMap[colorName];
        }
        else if (colorName.StartsWith("#"))
        {
            // Already a hex color
            hexColor = colorName;
        }
        else
        {
            // Unknown color, return default
            return "#D3D3D3"; // light grey
        }

        // Remove # if present
        hexColor = hexColor.TrimStart('#');

        // Parse hex color
        if (hexColor.Length == 6)
        {
            try
            {
                int r = Convert.ToInt32(hexColor.Substring(0, 2), 16);
                int g = Convert.ToInt32(hexColor.Substring(2, 2), 16);
                int b = Convert.ToInt32(hexColor.Substring(4, 2), 16);

                // Make color lighter by blending with white (increase each component by 50%)
                // r = Math.Min(255, r + (int)((255 - r) * 0.5));
                // g = Math.Min(255, g + (int)((255 - g) * 0.5));
                // b = Math.Min(255, b + (int)((255 - b) * 0.5));

                return $"#{r:X2}{g:X2}{b:X2}";
            }
            catch
            {
                return "#D3D3D3"; // light grey fallback
            }
        }

        return "#D3D3D3"; // light grey fallback
    }

    int selectedchildID;
    int ID;
    string Roles;
    Student student;
    Parent parent;

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        }

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
        if (Roles == "Parent")
        {
            foreach (var studentpom in ParentService.Parents)
            {
                if (studentpom.ParentID == ID)
                {
                    parent = studentpom;
                    if (parent.LastSelectedChildId.Value != null)
                    {
                        selectedchildID = parent.LastSelectedChildId.Value;
                        student = await StudentService.GetStudentById(selectedchildID);
                    }
                }
            }
        }
    }
}