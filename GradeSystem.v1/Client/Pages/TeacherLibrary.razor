@page "/teacherlibrary"
@inject IBookService BookService
@inject IBookTypeService BookTypeService
@inject IStudentService StudentService
@inject IBookServiceSupport BookServiceSupport
@inject NavigationManager NavigationManager
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Text;
@using System.Text.RegularExpressions;
@attribute [Authorize(Roles = "Admin, Teacher, Librarian")]
<div class="mainlibraryview">
    <div class="booksdisplay">
        @foreach (var segment in segments)
        {
            @for (int j = 0; j < 4; j=j)
            {
            string imgurl = "/Img/" + @booktype.Title + @booktype.Author + @booktype.Edition + ".jpg";
                string imgrul = "https://www.justwatch.com/images/poster/308793523/s718/12-monkeys.jpg";
                <div class="bookrow">

                    <div class="book-grid">
                        <div class="book-card">
                            <img src=@imgurl alt ="Book Cover" class="book-cover" />
                            <div class="book-buttons">
                                <button class="reserve-btn" @onclick="() => EditBooks(segment.bookType.BookTypeID)">Edit</button>
                                <button class="book-btn">Lend</button>
                            </div>
                            <div class="availability">
                                <span class="badge available">@segment.bookType.AmountOfBooks / @segment.numberofbooks  Available</span>
                                <span class="badge unavailable">@segment.numberofborowed / @segment.numberofbooks Borowed</span>
                            </div>
                            <div class="book-meta">
                                <h4>@segment.bookType.Title</h4>
                                <p>@segment.bookType.Author</p>
                            </div>
                        </div>
                    </div>
                    </div>
                
            }

        }
    
    </div>
</div>
<div class="mainlibraryview">
    <div class="booksdisplay">
        
        <div class="search-bar">
            <input type="text" @oninput="FillTable" />
        </div>

     
    </div>
    @if (showbooks == true)
    {
    <table class="styled-table">
            <thead>
            <tr>
                <th colspan="3" class="top-title">Title</th>
            </tr>
                <tr>
                    <th>ID</th>
                    <th>Status</th>
                    <th>Edit</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @foreach(var book in BookService.Books)
                    {
                        if (Selectedbooktypeid == book.BookTypeID)
                        {                                               
                            <td>@book.BookID</td>
                            if(book.IsBoocked)
                            {
                                <td>Boocked</td>
                            }
                            else if(book.IsBorowed)
                            {
                                <td>Borowed</td>
                            }
                            else
                            {
                                <td>Available</td>
                            }
                            <td><button  @onclick="(()=>EditBook(book))" class="edit-button">Edytyj</button></td>
                        }
                    }
                </tr>
            </tbody>
        </table>
    }
    else
    {
        <div class="sidelibrarybox">
            <div class="buttonboxlib">
                @if (yourbooks == true)
                {
                    <div><button>Borrow Books</button></div>
                }
                else
                {
                    <button disabled>Borrow Books</button>
                }
                @if (yourbooks == false)
                {
                    <div><button>Your Books</button></div>
                }
                else
                {
                    <button disabled>Your Books</button>
                }
                <div>
                    <input @oninput="FillTable" />
                    @btnText
                </div>
                <button class="searchforbook">Search</button>
            </div>
            <div class="bookview">
                <img src="https://www.justwatch.com/images/poster/308793523/s718/12-monkeys.jpg" class="bookimgview">
                <div class="booknameview">Twelve Monkeys</div>
                <div class="bookauthorview">John Newman</div>
                <div class="bookdescview">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent nec viverra arcu, ut facilisis libero. Maecenas hendrerit tincidunt lorem, id iaculis metus vehicula in. Integer sit amet eros non tortor congue varius. Etiam condimentum ligula vel imperdiet commodo. Cras commodo mi at est porta dapibus. Fusce finibus scelerisque nulla, ut suscipit sapien fringilla et.</div>
            </div>


        </div>
        
    }

    </div>
    




    

@code {

    void GoToBookType()
    {
        NavigationManager.NavigateTo($"AddEditBook");
    }

    void GoToBookBorowing(int QR)
    {
        NavigationManager.NavigateTo($"/Borrow/{QR}");
    }

    IList<BookView> BookAmount = new List<BookView>();
    private BookAddEditPopup popupref;
    private AddBookPopup popuprefadd;
    async Task FillTable(ChangeEventArgs args)
    {
        btnText = args.Value.ToString();

        await DoUpdateList();
    }

    protected override async Task OnInitializedAsync()
    {
        await StudentService.GetStudents();
        await BookService.GetBooks();
        await DoUpdateList();
    }

    string bar;
    bool isawailable = false;
    bool yourbooks = false;
    string btnText = string.Empty;
    int ID;
    bool showbooks = false;
    int? Selectedbooktypeid = null;
    Student student;
    BookType booktype;
    BookType booktype2;
    string Roles;
    private List<Segmentt> segments = new List<Segmentt>();
    private class Segmentt
    {
        public int? numberofbooks { get; set; }
        public int? numberofborowed { get; set; }
        public BookType bookType { get; set; }
    }

    async Task DoUpdateList()
    {
        await BookServiceSupport.UpdateList(isawailable, btnText);
        await CreateSegments();
    }



    async Task CreateSegments()
    {
        if (segments.Count > 0)
        {
            segments.Clear();
        }
        foreach (var booktype in BookServiceSupport.LiblarianBookList)
        {
            var segment = new Segmentt
                {
                    numberofbooks = 0,
                    numberofborowed = 0,
                    bookType = booktype
                };

            segments.Add(segment);
        }
        foreach (var book in BookService.Books)
        {
            foreach(var booktype in segments)
            {
                if(book.BookTypeID == booktype.bookType.BookTypeID)
                {
                    if (booktype.bookType.Books == null)
                    {
                        booktype.bookType.Books = new List<Book>();
                    }
                    booktype.numberofbooks += 1;
                    if(book.IsBorowed)
                    {
                        booktype.numberofborowed += 1;
                    }
                }
            }
        }
    }


    async Task EditBook(Book book)
    {
        showedit(book);
    }

    async Task EditBooks(int booktypeid)
    {
        Selectedbooktypeid = booktypeid;
        showbooks = true;
    }

    private void showedit(Book book)
    {
        popupref.ShowBookedit(book);
    }

    async Task AddBook(BookType booktype)
    {
        showeAdd(booktype);
    }

    private void showeAdd(BookType booktype)
    {
        popuprefadd.ShowBookAdd(booktype);
    }

    async Task ReturnToAvailable(Book book)
    {
        book.ReturnDate = null;
        book.ReservationDate = null;
        book.BorowingDate = null;
        book.Student = null;
        book.StudentId = null;
        book.IsBorowed = false;
        book.IsBoocked = false;
        await BookService.UpdateBook(book);
    }
}


