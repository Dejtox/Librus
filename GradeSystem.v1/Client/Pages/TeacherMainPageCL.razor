@page "/teachermainpagecl"
@inject IEnrollmentService EnrollmentService
@inject NavigationManager NavigationManager
@inject ITeacherService TeacherService
@inject ILessonsHoursService LessonsHoursService
@attribute [Authorize(Roles = "Admin, Teacher, Secretary, Librarian, Principal")]

<div class="CLtable">

    <div class="CLtableheader">
        <div class="CLtitle">Current Lesson</div>
    </div>

    <div class="CLdisplay">


       <div class="CLlesson">
           <div>Lesson : 2</div>
       </div>
       <div class="CLdata">
           <div>Maths (Grade 6)</div>
       </div>

       <div class="CLsubdisplay">

            <div class="CLtablerow">
                <button class="CLbutton" style="background-color: rgb(91,208,145)" @onclick="@(()=>NavigationManager.NavigateTo("/attendances"))">
                    <div class="gg-check-r"></div>
                    <div class="CLbuttonname">Attendance</div>
                </button>
                <button class="CLbutton" style="background-color: rgb(248,148,56)" @onclick="@(()=>NavigationManager.NavigateTo("/gradesviewteacher/"+ enrollment.EnrollmentID))">
                    <div class="gg-check-o"></div>
                    <div class="CLbuttonname">Grades</div>
                </button>

            </div>


            <div class="CLtablerow">    
                <button class="CLbutton" style="background-color: rgb(91,103,208)" @onclick="@(()=>NavigationManager.NavigateTo("https://drive.google.com/drive/folders/1Y9Pyid0296UbUu-LTWMNQ3Fx9oiUHT73"))">
                    <div class="gg-box"></div>
                    <div class="CLbuttonname">Materials</div>
                </button>
                <button class="CLbutton" style="background-color: rgb(4,98,118)" @onclick="@(()=>NavigationManager.NavigateTo("/subjects"))">
                    <div class="gg-add"></div>
                    <div class="CLbuttonname">Subject</div>
                </button>

            </div>

            <div class="CLtablerow">
                <button class="CLbutton" style="background-color: rgb(255,210,63)" @onclick="@(()=>NavigationManager.NavigateTo("/tests"))">
                    <div class="gg-pen"></div>
                    <div class="CLbuttonname">Tests</div>
                </button>
                <button class="CLbutton" style="background-color: rgb(230,95,95)" @onclick="@(()=>NavigationManager.NavigateTo("/notes"))">
                    <div class="gg-pacman"></div>
                    <div class="CLbuttonname">Note</div>
                </button>
            </div>
            
       </div>

    </div>
</div>
@code {
    int ID;
    string Roles;
    Teacher teacher;
    Enrollment enrollment;
    protected override async Task OnInitializedAsync()
    {
        await EnrollmentService.GetEnrollments();
        await GetClaimsGetID();
        await Finderolment();

    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task  Finderolment()
    {
        DateTime dateTimenow = DateTime.Now;
        foreach(var enr in EnrollmentService.Enrollments)
        {
            if(enr.Subject.TeacherID == teacher.TeacherID)
            {
                if (enr.Date.Year == dateTimenow.Year && enr.Date.Month == dateTimenow.Month && enr.Date.Day == dateTimenow.Day)
                {
                    if(enr.Date < dateTimenow && enr.EndDate > dateTimenow)
                    {
                        enrollment = enr;
                    }
                }
            }
        }
    }



    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        };

        if (Roles == "Teacher")
        {
            foreach (var teacherpom in TeacherService.Teachers)
            {
                if (teacherpom.TeacherID == ID)
                {
                    teacher = teacherpom;
                }
            }
        }
    }
}
