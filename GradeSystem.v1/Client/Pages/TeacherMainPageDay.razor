@page "/teachermainpageday"
@inject ITeacherService TeacherService
@inject ISubjectService SubjectService
@inject IEnrollmentService EnrollmentService
@inject IClassService ClassService
@inject ILessonsHoursService LessonsHoursService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin, Teacher, Secretary, Librarian, Principal")]

<div class="TEtable">

    <div class="TEtableheader">
        <div class="TEtitle">Your day</div>
    </div>

    <div class="TEdisplay">

        <div class="DateToday">@Today.DayOfWeek, @Today.ToString("dd.MM") </div>

        <div class="TEsubdisplay">
            @foreach (var lessonhour in SortedlessonsHours)
            {
                bool i = true;
                @foreach (var enrl in EnrolmentsFortoday)
                {
                    if (lessonhour.Start.TimeOfDay >= enrl.Date.TimeOfDay && lessonhour.End.TimeOfDay <= enrl.EndDate.TimeOfDay)
                    {
                        <div class="TEtablerow">
                            <button class="TEdata" @onclick="@(() => MoveTo(enrl.EnrollmentID))">
                                <div class="TEsubject">@lessonhour.LessonNo @enrl.Subject.SubjectName</div>

                                <div class="TEclass">(@enrl.Class.ClassName)</div>
                            </button>
                        </div>
                        i = false;
                    }
                }
                @if (i == true)
                {
                    <div class="TEtablerow">
                        <div class="TEdata">
                            <div class="TEsubject">@lessonhour.LessonNo</div>
                        </div>
                    </div>
                }

            }

        </div>

    </div>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        await TeacherService.GetTeachers();
        await SubjectService.GetSubjects();
        await EnrollmentService.GetEnrollments();
        await ClassService.GetClasses();
        await LessonsHoursService.GetLessonsHours();
        Today = DateTime.Now;
        await GetClaimsGetID();
        await SortEnrollments();
        await SortLessonHours();
    }



    int ID;
    Teacher teacher;
    Class classes;
    string Roles;
    DateTime Today = DateTime.Now;
    IList<LessonsHours> SortedlessonsHours = new List<LessonsHours>();
    IList<Enrollment> EnrolmentsFortoday = new List<Enrollment>();



    async Task SortEnrollments()
    {
        foreach (var enrl in EnrollmentService.Enrollments)
        {
            if (enrl.Subject.TeacherID == teacher.TeacherID)
            {
                if (enrl.Date.Month == Today.Month && enrl.Date.Day == Today.Day)
                {
                    EnrolmentsFortoday.Add(enrl);
                }
            }
        }

    }


    async Task SortLessonHours()
    {
        for (int i = 0; i < LessonsHoursService.LessonsHours.Count; i = i + 1)
        {
            foreach (var segment in LessonsHoursService.LessonsHours)
            {
                if (segment.LessonNo == i + 1)
                {
                    SortedlessonsHours.Add(segment);
                }
            }
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        }
        ;

        if (Roles == "Teacher")
        {
            foreach (var teacherpom in TeacherService.Teachers)
            {
                if (teacherpom.TeacherID == ID)
                {
                    teacher = teacherpom;
                }
            }
        }
    }
    async Task MoveTo(int id)
    {
        NavigationManager.NavigateTo($"CurrentLesson/{id}");
    }


}
