            background: #fd79a8 !important;
        }

        .sticky-note.blue {
            background: #74b9ff !important;
        }

        .sticky-note.green {
            background: #00b894 !important;
        }

        .sticky-note.orange {
            background: #fdcb6e !important;
        }

        .sticky-note.purple {
            background: #a29bfe !important;
        }

