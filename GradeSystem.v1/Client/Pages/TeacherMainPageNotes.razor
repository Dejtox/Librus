@page "/teachermainpagenotes"
@page "/teachermainpagenotes/{id:int}"
@inject INoteService NoteService
@attribute [Authorize(Roles = "Admin, Teacher, Secretary, Librarian, Principal")]
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="Nheader">
    <div class="Ntitle">Notes</div>
</div>

<div class="notes-container">
    <div class="notes-header">
        <div class="notes-title">My Sticky Notes</div>
        <button class="add-note-btn" @onclick="ShowCreateNoteModal">
            <span class="add-icon">+</span>
            Add Note
        </button>
    </div>
    <div class="notes-grid">
        @if (notes != null && notes.Any())
        {
            @for (int i = 0; i < notes.Count; i++)
            {
                var note = notes[i];
                var index = i;

                <div class="sticky-note @GetNoteColorClass(note.Color) @(draggedNote?.NoteID == note.NoteID ? "dragging" : "")"
                     draggable="true"
                     @ondragstart="(e) => HandleDragStart(e, note)"
                     @ondragover="HandleDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="(e) => HandleDrop(e, index)"
                     @ondrop:preventDefault="true"
                     @ondragend="HandleDragEnd"
                     @onclick="() => EditNote(note)">

                    <div class="note-header">
                        <div class="note-title">@note.Title</div>
                        <div class="note-position">@note.Position</div>
                        <button class="delete-btn"
                                @onclick="(e) => DeleteNoteWithConfirm(e, note)"
                                @onclick:stopPropagation="true">
                            ×
                        </button>
                    </div>

                    <div class="note-content">@note.Content</div>
                    <div class="drag-handle">⋮⋮</div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📝</div>
                <div class="empty-text">No notes yet. Create your first sticky note!</div>
            </div>
        }

        </div>
    </div>

        @if (showModal)
        {
            <div class="modal-overlay" @onclick="CloseModal">
                <div class="modal-content" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(isPreviewing ? "Note Preview" : isEditing ? "Edit Note" : "Create New Note")</h3>
                        <button class="close-btn" @onclick="CloseModal">×</button>
                    </div>

                    @if (isPreviewing)
                    {
                        <div>
                            <h4 style="margin-top: 0">@currentNote.Title</h4>
                            <p>@currentNote.Content</p>
                            <div class="modal-actions">
                                <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
                                <button class="btn btn-primary" @onclick="StartEditing">Edit</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="currentNote" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="form-group">
                                <label for="title">Title</label>
                                <InputText @bind-Value="currentNote.Title" class="form-input" />
                                <ValidationMessage For="@(() => currentNote.Title)" />
                            </div>

                            <div class="form-group">
                                <label for="content">Content</label>
                                <InputTextArea @bind-Value="currentNote.Content" class="form-textarea" rows="6" />
                                <ValidationMessage For="@(() => currentNote.Content)" />
                            </div>

                            <div class="form-group">
                                <label>Choose Color</label>
                                <div class="color-picker">
                                    @foreach (var color in availableColors)
                                    {
                                        <button type="button"
                                                class="color-option @(currentNote.Color == color.Value ? "selected" : "")"
                                                style="background-color: @color.Value"
                                                @onclick="() => SelectColor(color.Value)"
                                                title="@color.Name">
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="modal-actions">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                                <button type="submit" class="btn btn-primary">
                                    @(isEditing ? "Update Note" : "Create Note")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        }

<style>
    .notes-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        height: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
