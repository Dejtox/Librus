</style>

@code {
    [Parameter] public int? ID { get; set; }
    private bool isPreviewing = false;
    private List<Note> notes = new();
    private Note currentNote = new();
    private bool showModal = false;
    private bool isEditing = false;
    private Random random = new Random();
    private Note? draggedNote = null;
    private int currentTeacherID = 0;

    private List<ColorOption> availableColors = new() {
        new("Yellow", "#ffeaa7"),
        new("Pink", "#fd79a8"),
        new("Blue", "#74b9ff"),
        new("Green", "#00b894"),
        new("Orange", "#fdcb6e"),
        new("Purple", "#a29bfe"),
        new("Red", "#e17055"),
        new("Mint", "#81ecec")
    };

    public class ColorOption
    {
        public string Name { get; set; }
        public string Value { get; set; }
        public ColorOption(string name, string value) { Name = name; Value = value; }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentTeacherID();
        await LoadNotes();
    }

    private async Task GetCurrentTeacherID()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity.IsAuthenticated)
            {
                var teacherIdClaim = user.FindFirst("TeacherID")?.Value;
                if (int.TryParse(teacherIdClaim, out int teacherId))
                {
                    currentTeacherID = teacherId;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting teacher ID: {ex.Message}");
        }
    }

    private async Task LoadNotes()
    {
        try
        {
            await NoteService.GetNotes();
            var allNotes = NoteService.Notes?.ToList() ?? new();

            // Filter notes by current teacher ID
            notes = allNotes.Where(n => n.TeacherID == currentTeacherID).ToList();

            // Assign positions to notes that don't have them
            await AssignMissingPositions();

            // Sort notes by position (ascending - position 1 first)
            notes = notes.OrderBy(n => n.Position ?? int.MaxValue).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notes: {ex.Message}");
            notes = new();
        }
    }

    private async Task AssignMissingPositions()
    {
        var notesWithoutPosition = notes.Where(n => n.Position == null).ToList();
        if (notesWithoutPosition.Any())
        {
            var maxPosition = notes.Where(n => n.Position.HasValue).Max(n => n.Position) ?? 0;

            foreach (var note in notesWithoutPosition)
            {
                note.Position = ++maxPosition;
                await NoteService.UpdateNote(note);
            }
        }
    }

    private void ShowCreateNoteModal()
    {
        currentNote = new Note
            {
                Color = "#ffeaa7",
                Category = "General",
                TeacherID = currentTeacherID
            };
        isEditing = false;
        showModal = true;
    }

    private void EditNote(Note note)
    {
        currentNote = new Note
            {
                NoteID = note.NoteID,
                TeacherID = note.TeacherID,
                Title = note.Title,
                Content = note.Content,
                Color = note.Color,
                Category = note.Category,
                Position = note.Position
            };
        isEditing = false;
        isPreviewing = true;
        showModal = true;
    }

    private void StartEditing()
    {
        isPreviewing = false;
        isEditing = true;
    }

    private void CloseModal()
    {
        showModal = false;
        isEditing = false;
        isPreviewing = false;
        currentNote = new Note();
    }

    private void SelectColor(string color)
    {
        currentNote.Color = color;
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(currentNote.Title)) currentNote.Title = "Untitled Note";
            if (string.IsNullOrWhiteSpace(currentNote.Category)) currentNote.Category = "General";

            currentNote.TeacherID = currentTeacherID;

            if (isEditing)
            {
                // For existing notes, move to position 1 and shift others
                await MoveNoteToTop(currentNote);
                await NoteService.UpdateNote(currentNote);
            }
            else
            {
                // For new notes, set position to 1 and shift others
                await ShiftPositionsForNewNote();
                currentNote.Position = 1;
                await NoteService.CreateNote(currentNote);
            }

            await LoadNotes();
            CloseModal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving note: {ex.Message}");
        }
    }

    private async Task MoveNoteToTop(Note noteToMove)
    {
        var currentPosition = noteToMove.Position ?? int.MaxValue;

        // Shift all notes with position < currentPosition down by 1
        foreach (var note in notes.Where(n => n.NoteID != noteToMove.NoteID && n.Position < currentPosition))
        {
            note.Position++;
            await NoteService.UpdateNote(note);
        }

        noteToMove.Position = 1;
    }

    private async Task ShiftPositionsForNewNote()
    {
        // Shift all existing notes down by 1 position
        foreach (var note in notes)
        {
            if (note.Position.HasValue)
            {
                note.Position++;
                await NoteService.UpdateNote(note);
            }
        }
    }

    private void HandleDragStart(DragEventArgs e, Note note)
    {
        draggedNote = note;
        e.DataTransfer.EffectAllowed = "move";
        // e.DataTransfer.SetData("text/plain", note.NoteID.ToString());
    }

    private void HandleDragOver(DragEventArgs e)
    {
        e.DataTransfer.DropEffect = "move";
    }

    private async Task HandleDrop(DragEventArgs e, int dropIndex)
    {
        if (draggedNote != null)
        {
            var draggedIndex = notes.FindIndex(n => n.NoteID == draggedNote.NoteID);

            if (draggedIndex != dropIndex && draggedIndex >= 0)
            {
                await ReorderNotes(draggedIndex, dropIndex);
                await LoadNotes();
                StateHasChanged();
            }
        }

        draggedNote = null;
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        draggedNote = null;
    }

    private async Task ReorderNotes(int fromIndex, int toIndex)
    {
        try
        {
            var draggedNote = notes[fromIndex];
            var targetNote = notes[toIndex];
            var newPosition = targetNote.Position ?? (toIndex + 1);

            if (fromIndex < toIndex)
            {
                // Moving down in the list (increasing position)
                // Shift notes between fromIndex+1 and toIndex up (decrease position)
                for (int i = fromIndex + 1; i <= toIndex; i++)
                {
                    var note = notes[i];
                    if (note.Position.HasValue && note.NoteID != draggedNote.NoteID)
                    {
                        note.Position--;
                        await NoteService.UpdateNote(note);
                    }
                }
            }
            else
            {
                // Moving up in the list (decreasing position)
                // Shift notes between toIndex and fromIndex-1 down (increase position)
                for (int i = toIndex; i < fromIndex; i++)
                {
                    var note = notes[i];
                    if (note.Position.HasValue && note.NoteID != draggedNote.NoteID)
                    {
                        note.Position++;
                        await NoteService.UpdateNote(note);
                    }
                }
            }

            // Set the dragged note's new position
            draggedNote.Position = newPosition;
            await NoteService.UpdateNote(draggedNote);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reordering notes: {ex.Message}");
        }
    }

    private async Task DeleteNoteWithConfirm(MouseEventArgs e, Note note)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{note.Title}'?");
        if (confirmed)
        {
            try
            {
                await NoteService.DeleteNote(note.NoteID);
                await ShiftPositionsAfterDelete(note.Position ?? 0);
                await LoadNotes();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting note: {ex.Message}");
            }
        }
    }

    private async Task ShiftPositionsAfterDelete(int deletedPosition)
    {
        // Shift all notes with position > deletedPosition up by 1 (decrease position)
        foreach (var note in notes.Where(n => n.Position > deletedPosition))
        {
            note.Position--;
            await NoteService.UpdateNote(note);
        }
    }

    private string GetNoteColorClass(string color) => color switch
    {
        "#ffeaa7" => "yellow",
        "#fd79a8" => "pink",
        "#74b9ff" => "blue",
        "#00b894" => "green",
        "#fdcb6e" => "orange",
        "#a29bfe" => "purple",
        "#e17055" => "red",
        "#81ecec" => "mint",
        _ => "yellow"
    };

    private int GetRandomX() => random.Next(50, 800);
    private int GetRandomY() => random.Next(50, 400);
}