@page "/yourschedulemonth"

@inject IStudentService StudentService
@inject IEventService EventService
@inject IEnrollmentService EnrollmentService
@inject ISchoolTripService SchoolTripService
@inject ISubjectService SubjectService
@inject IEventService EventServic
@inject NavigationManager NavigationManager

<div class="mainbox">
    <div class="Msidebox1">
        <div class="Msubsidebox1">
            <div class="Msubsideboxheader">
                <div class="Msubsidemonthyear">
                    <div class="gg-chevron-left"></div>
                    <div>@SelcetedMonth.ToString("MMMM") @SelcetedMonth.Year</div>
                    <div class="gg-chevron-right"></div>
                </div>

                <select class="Mchangemodes" @onchange="NavigateToPage">
                    <option selected>Month<div class="gg-chevron-down"></div></option>
                    <option value="/yourscheduleweek">Week<div class="gg-chevron-down"></div></option>
                </select>
            </div>


            <div class="Mdays">
                <div class="Mdayhead">Monday</div>
                <div class="Mdayhead">Tuesday</div>
                <div class="Mdayhead">Wednesday</div>
                <div class="Mdayhead">Thursday</div>
                <div class="Mdayhead">Friday</div>
                <div class="Mdayhead">Saturday</div>
                <div class="Mdayhead">Sunday</div>
            </div>




            <div class="Month">
                @for (int j = 1; j < 7; j++)
                {
                    <div class="MonthRow">
                        @for (int i = 1; i < 8; i++)
                        {
                            int x = 1;
                            x = 1;
                            <div class="Msingle">
                                @if ((i + (j - 1) * 7) < (((int)SelcetedMonth.DayOfWeek + 6) % 7) + 1)
                                {
                                    <div></div>
                                }
                                else
                                {
                                    if ((i + (j - 1) * 7) - (((int)SelcetedMonth.DayOfWeek + 6) % 7) + 1 > DateTime.DaysInMonth(SelcetedMonth.Year, SelcetedMonth.Month) + 1)
                                    {
                                        <div></div>
                                    }
                                    else
                                    {
                                        if (subtest)
                                        {
                                            @foreach (var enr in SubstituteEnrlList)
                                            {

                                                if ((i + (j - 1) * 7) - daydif == enr.Date.Day)
                                                {
                                                    <div>@enr.SubEnrollment.Subject </div> @*?rodek tablecell*@
                                                    x--;
                                                }
                                            }
                                        }
                                        if (examtest)
                                        {
                                            @foreach (var test in ExamList)
                                            {
                                        
                                                if ((i + (j - 1) * 7) - daydif == enr.Date.Day)
                                                {
                                                        <div>@enr.SubEnrollment.Subject </div> @*?rodek tablecell*@
                                                x--;
                                                }
                                            }
                                        }
                                        if (eventest)
                                        {
                                            @foreach (var evn in EvnlList)
                                            {
                                                if ((i + (j - 1) * 7) - daydif >= evn.StartDate.Day && (i + (j - 1) * 7) - daydif <= evn.EndDate.Day)
                                                {
                                                    if ((i + (j - 1) * 7) - daydif == test.test.StartDate.Day)
                                                    {
                                                        <div>@test.subject.SubjectName</div>
                                                        @*?rodek tablecell*@
                                                        x--;
                                                    }
                                                }
                                            }
                                        }
                                        if (x == 1)
                                        {
                                            <div></div>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>

                }
            </div>

        </div>
    </div>

    <div class="Msidebox2">
        <div class="checkboxes">
            <label class="container123 @(examtest ? "active": "inactive")">
                Exams
                <input type="checkbox" @bind="examtest">
                <span class="checkmark checkmark--1"></span>
            </label>

            <label class="container123 @(eventest ? "active": "inactive")">
                Events
                <input type="checkbox" @bind="eventest">
                <span class="checkmark checkmark--2"></span>
            </label>

            <label class="container123 @(subtest ? "active": "inactive")">
                Substitutions
                <input type="checkbox" @bind="subtest">
                <span class="checkmark checkmark--3"></span>
            </label>
        </div>
    </div>

</div>


@code {
    public class Exam
    {
        public CalendarEvent test;
        public Subject subject;
        public Exam(Subject subjectadd, CalendarEvent testadd)
        {
            subject = subjectadd;
            test = testadd;
        }
    }
    bool subtest = true;
    bool examtest = true;
    bool eventest = true;
    int ID;
    int daydif;
    Student student;
    string Roles;
    DateTime SelcetedMonth;
    List<Enrollment> SubstituteEnrlList = new List<Enrollment>();
    List<Exam> ExamList = new List<Exam>();
    List<SchoolTrip> EvnlList = new List<SchoolTrip>();
    protected override async Task OnInitializedAsync()
    {
        SelcetedMonth = DateTime.Now;
        SelcetedMonth = new DateTime(SelcetedMonth.Year, SelcetedMonth.Month, 1);
        await GetClaimsGetID();
        await EventService.GetCalendarEvents();
        await EnrollmentService.GetEnrollments();
        await SchoolTripService.GetSchoolTrips();
        await SubjectService.GetSubjects();
        await FillEnrListDates();
        await FillTests();
        await FillTrips();
    }
    async Task FillTests()
    {
        @foreach (var evn in EventService.Events)
        {
            if (evn.Description == "Exam")
            {
                if (student.ClassID == evn.ClassID)
                {
                    if(evn.StartDate.Month == SelcetedMonth.Month && evn.StartDate.Year == SelcetedMonth.Year)
                    {
                        foreach(var subject in SubjectService.Subjects)
                        {
                            if(subject.SubjectID == evn.SubjectID)
                            {
                                ExamList.Add(new Exam(subject, evn));
                            }
                        }
                        
                    }
                }
            }
        }
    }

    async Task FillTrips()
    {
        @foreach (var evn in SchoolTripService.SchoolTrips)
        {
            foreach(var schoolclass in evn.Classes)
            {
                if (student.ClassID == schoolclass.ClassID)
                {
                    if (evn.StartDate.Month == SelcetedMonth.Month && evn.StartDate.Year == SelcetedMonth.Year)
                    {
                        EvnlList.Add(evn);

                    }
                }
            }
        }
    }

    async Task FillEnrListDates()
    {       
            SubstituteEnrlList.Clear();
        int daysinmonth = DateTime.DaysInMonth(SelcetedMonth.Year, SelcetedMonth.Month);
        SubstituteEnrlList = new List<Enrollment>();

            foreach (var enr in EnrollmentService.Enrollments)
            {                
                if(enr.SubEnrollmentID != null)
                {
                if (enr.Date.Month == SelcetedMonth.Month && enr.Date.Year == SelcetedMonth.Year)
                    {                       
                            SubstituteEnrlList.Add(enr);                    
                    }
                }
            }
        
    }
    private void NavigateToPage(ChangeEventArgs e)
    {
        var selectedValue = e.Value.ToString();

        if (!string.IsNullOrEmpty(selectedValue))
        {
            NavigationManager.NavigateTo(selectedValue);
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }


    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        };

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
    }

}
