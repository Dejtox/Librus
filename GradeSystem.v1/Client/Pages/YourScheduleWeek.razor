@code {
    public class Evnforday {
        public Enrollment stdlesson;
        public Enrollment? substitutes;

        public CalendarEvent? upcomingexams;
        public Evnforday(Enrollment enrollment, Enrollment enrollment1, CalendarEvent calendarEvent)
        {
            stdlesson = enrollment;
            substitutes = enrollment1;
            upcomingexams =calendarEvent;
        }
    }
    IList<Evnforday> StudentsEnrolmentsMon = new List<Evnforday>();
    IList<Evnforday> StudentsEnrolmentsTue = new List<Evnforday>();
    IList<Evnforday> StudentsEnrolmentsWen = new List<Evnforday>();
    IList<Evnforday> StudentsEnrolmentsThu = new List<Evnforday>();
    IList<Evnforday> StudentsEnrolmentsFri = new List<Evnforday>();
    IList<LessonsHours> SortedlessonsHours = new List<LessonsHours>();
    IList<SchoolTrip> Schooltrips = new List<SchoolTrip>();
    DateTime Today = DateTime.Now;
    DateTime UpToDateMonday;
    int ID;
    Student student;
    string Roles;

    protected override async Task OnInitializedAsync()
    {
        await SubjectService.GetSubjects();
        await StudentService.GetStudents();
        await SchoolTripService.GetSchoolTrips();
        await EventService.GetCalendarEvents();
        await GetClaimsGetID();
        await EnrollmentService.GetEnrollments();
        await Finduptodatemonday();
        await LessonsHoursService.GetLessonsHours();
        await SortLessonHours();
        await FillTrips();
    }

    async Task Finduptodatemonday()
    {

        if (Today.DayOfWeek == DayOfWeek.Saturday || Today.DayOfWeek == DayOfWeek.Sunday)
        {
            if (Today.DayOfWeek == DayOfWeek.Saturday)
            {
                UpToDateMonday = Today.AddDays(2);
            }
            else
            {
                UpToDateMonday = Today.AddDays(1);
            }
        }
        else
        {
            int difrence = Today.DayOfWeek - DayOfWeek.Monday;
            if (difrence != 0)
            {
                UpToDateMonday = Today.AddDays(-difrence);
            }
            else
            {
                UpToDateMonday = Today;
            }
        }
    }



    async Task SortLessonHours()
    {
        for (int i = 0; i < LessonsHoursService.LessonsHours.Count; i = i + 1)
        {
            foreach (var segment in LessonsHoursService.LessonsHours)
            {
                if (segment.LessonNo == i + 1)
                {
                    SortedlessonsHours.Add(segment);
                }
            }
        }
    }
    //kom

    async Task Setemptylessonhour()
    {
        DateTime temp;
        Evnforday evnfordaytoadd;
        foreach (var enrolment in EnrollmentService.Enrollments)
        {
            if (enrolment.ClassID == student.ClassID)
            {
                temp = UpToDateMonday;
                if (enrolment.Date.Day == temp.Day && enrolment.Date.Month == temp.Month)
                {
                    SchoolTrip? schoolTrip = null;
                    CalendarEvent? upcomingexams = null;
                    evnfordaytoadd = new Evnforday(enrolment, enrolment, upcomingexams);
                    StudentsEnrolmentsMon.Add(evnfordaytoadd);
                }
                temp = UpToDateMonday.AddDays(1);
                if (enrolment.Date.Day == temp.Day && enrolment.Date.Month == temp.Month)
                {
                    SchoolTrip? schoolTrip = null;
                    CalendarEvent? upcomingexams = null;
                    evnfordaytoadd = new Evnforday(enrolment, enrolment, upcomingexams);
                    StudentsEnrolmentsTue.Add(evnfordaytoadd);
                }
                temp = UpToDateMonday.AddDays(2);
                if (enrolment.Date.Day == temp.Day && enrolment.Date.Month == temp.Month)
                {
                    SchoolTrip? schoolTrip = null;
                    CalendarEvent? upcomingexams = null;
                    evnfordaytoadd = new Evnforday(enrolment, enrolment, upcomingexams);
                    StudentsEnrolmentsWen.Add(evnfordaytoadd);
                }
                temp = UpToDateMonday.AddDays(3);
                if (enrolment.Date.Day == temp.Day && enrolment.Date.Month == temp.Month)
                {
                    SchoolTrip? schoolTrip = null;
                    CalendarEvent? upcomingexams = null;
                    evnfordaytoadd = new Evnforday(enrolment, enrolment, upcomingexams);
                    StudentsEnrolmentsThu.Add(evnfordaytoadd);
                }
                temp = UpToDateMonday.AddDays(4);
                if (enrolment.Date.Day == temp.Day && enrolment.Date.Month == temp.Month)
                {
                    SchoolTrip? schoolTrip = null;
                    CalendarEvent? upcomingexams = null;
                    evnfordaytoadd = new Evnforday(enrolment, enrolment, upcomingexams);
                    StudentsEnrolmentsFri.Add(evnfordaytoadd);
                }
            }
        }
        Fillinevnts();
    }
    async Task FillTrips()
    {
        foreach (var trip in SchoolTripService.SchoolTrips)
        {
            foreach (var schoolclass in trip.Classes)
            {
                if (schoolclass.ClassID == student.ClassID)
                {
                    if ((UpToDateMonday <= trip.StartDate && UpToDateMonday.AddDays(5) >= trip.StartDate) || (UpToDateMonday <= trip.EndDate && UpToDateMonday.AddDays(5) >= trip.EndDate))
                    {
                        Schooltrips.Add(trip);
                    }
                    break;
                }
             }
        }
    }
    async Task Fillinevnts()
    {
        foreach( var evn in EventService.Events)
        {
            if (evn.Description == "Exam")
            {
                if (evn.ClassID == student.ClassID)
                {
                    foreach (var lesson in StudentsEnrolmentsMon)
                    {
                        if (lesson.stdlesson.Date == evn.StartDate)
                        {
                            lesson.upcomingexams = evn;
                        }
                    }
                    foreach (var lesson in StudentsEnrolmentsTue)
                    {
                        if (lesson.stdlesson.Date == evn.StartDate)
                        {
                            lesson.upcomingexams = evn;
                        }
                    }
                    foreach (var lesson in StudentsEnrolmentsWen)
                    {
                        if (lesson.stdlesson.Date == evn.StartDate)
                        {
                            lesson.upcomingexams = evn;
                        }
                    }
                    foreach (var lesson in StudentsEnrolmentsThu)
                    {
                        if (lesson.stdlesson.Date == evn.StartDate)
                        {
                            lesson.upcomingexams = evn;
                        }
                    }
                    foreach (var lesson in StudentsEnrolmentsFri)
                    {
                        if (lesson.stdlesson.Date == evn.StartDate)
                        {
                            lesson.upcomingexams = evn;
                        }
                    }
                }
            }
            
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }

    private async Task GetClaimsGetID()
    {
        var user = (await authenticationState).User;
        foreach (var claim in user.Claims)
        {
            if (claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
            {
                ID = Int32.Parse(claim.Value);
            }
            if (claim.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
            {
                Roles = claim.Value;
            }
        };

        if (Roles == "Student")
        {
            foreach (var studentpom in StudentService.Students)
            {
                if (studentpom.StudentID == ID)
                {
                    student = studentpom;
                }
            }
        }
    }



    private void NavigateToPage(ChangeEventArgs e)
    {
        var selectedValue = e.Value.ToString();

        if (!string.IsNullOrEmpty(selectedValue))
        {
            NavigationManager.NavigateTo(selectedValue);
        }
    }
}
